        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113800934822151957', 'user_id': '109316662041388619', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Just sent you a text. I might have someone that needs my help evacuating. Any help assessing the situation would be so appreciated!&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 23:14:15', 'in_reply_to_id': '113800925351148083', 'reblog': None}" />
