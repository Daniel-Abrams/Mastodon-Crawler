      <node id="113797683034415473" label="113797683034415473">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797683034415473', 'user_id': '109273352232731189', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://climatejustice.social/@muellertadzio&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;muellertadzio&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Weißt du, es motiviert mich sehr, zu lesen, dass dir das auch schwer fällt. Oder allgemein anderen, den meisten. Ich hör mir mal das Radiofeature an und dann schau ich mal ob ich bei mir was starten kann.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 09:27:20', 'in_reply_to_id': '113797416179282762', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113797726159339162" label="113797726159339162">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797726159339162', 'user_id': '108193471567690291', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://social.tchncs.de/@skaphle&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;skaphle&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; ❤️ &lt;/p&gt;&lt;p&gt;echt den meisten! ich habe selten auf einen einzelnen punkt in einem text so viel feedback bekommen, wie auf genau diesen: richtig viele leute haben das bestätigt, und sich erleichtert gefühlt, weil es anderen auch so geht!&lt;/p&gt;&lt;p&gt;viel erfolg :)&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 09:38:12', 'in_reply_to_id': '113797683034415473', 'reblog': None}" />
        </attvalues>
      </node>
