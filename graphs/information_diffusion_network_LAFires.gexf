      <node id="113798678676203817" label="113798678676203817">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113798678676203817', 'user_id': '111543858640168242', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://adhd.irenes.space/@ireneista&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ireneista&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://udongein.xyz/users/lispi314&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;lispi314&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;/p&gt;&lt;p&gt;I\'m gonna butt in as a stranger and say thank you both so much for practicing clear communication and de-escalation / conflict resolution strats so openly. It\'s really nice to see, especially these days. &lt;/p&gt;&lt;p&gt;&amp;lt;/thankful rubber-necking,I guess?&amp;gt;&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 13:40:31', 'in_reply_to_id': '113798164353632351', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113800484902604100" label="113800484902604100">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113800484902604100', 'user_id': '112358176636091958', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot;&gt;&lt;a href=&quot;https://lgbtqia.space/@MxVerda&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;MxVerda&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; we\'re glad it came off that way, we worried about it, it\'s more intense than we usually are&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 21:18:30', 'in_reply_to_id': '113798678676203817', 'reblog': None}" />
