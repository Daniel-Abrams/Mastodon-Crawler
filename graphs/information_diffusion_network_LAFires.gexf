        <viz:color r="0" g="128" b="128" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113789020143880211', 'user_id': '109321601315889133', 'content': '&lt;p&gt;Massive traffic jam in Pacific Palisades. Fire vehicles unable to move. About now is where the bicycle/walk to the beach goes into play 😬 &lt;a href=&quot;https://m.ai6yr.org/tags/PalisadesFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;PalisadesFire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['palisadesfire'], 'created_at': '2025-01-07 20:44:11', 'in_reply_to_id': None, 'reblog': None}" />
