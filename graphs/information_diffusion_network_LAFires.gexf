          <attvalue for="0" value="{'id': '113303748825336874', 'user_id': '109452650553238887', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; parts of the US become uninhabitable faster than anyone thought ... We got to pay attention to what really matters ... and it ain\'t migrants or religion!!&lt;br&gt; &lt;a href=&quot;https://nerdculture.de/tags/ArizonaHeat&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ArizonaHeat&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://nerdculture.de/tags/FloridaHurrican&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FloridaHurrican&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://nerdculture.de/tags/CaliforniaWildfire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CaliforniaWildfire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://nerdculture.de/tags/NCFlood&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NCFlood&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://nerdculture.de/tags/LastGeneration&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LastGeneration&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://nerdculture.de/tags/StopOilNow&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;StopOilNow&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://nerdculture.de/tags/NoMoreCoal&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NoMoreCoal&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://nerdculture.de/tags/NoMoreGas&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NoMoreGas&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://nerdculture.de/tags/GreenNewDealNow&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;GreenNewDealNow&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['CaliforniaWildfire'], 'created_at': '2024-10-14 03:53:22', 'in_reply_to_id': '113302662930506648', 'reblog': None}" />
