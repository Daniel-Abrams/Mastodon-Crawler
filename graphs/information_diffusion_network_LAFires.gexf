      <node id="113796071282007398" label="113796071282007398">
        <viz:color r="226" g="88" b="34" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113796071282007398', 'user_id': '109321601315889133', 'content': '&lt;p&gt;Evacuations moving fast on Sunset Fire in the Hollywood Hills. Evacuate early, those are tight streets with a lot of dead ends. Evacs as of 1/8/25 1837PT &lt;a href=&quot;https://m.ai6yr.org/tags/SunsetFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SunsetFire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['sunsetfire'], 'created_at': '2025-01-09 02:37:25', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113796080133303753" label="113796080133303753">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113796080133303753', 'user_id': '109362756966520946', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; ABC7 is overhead doing a good job of street map overlays on top of the live fire scene.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:39:40', 'in_reply_to_id': '113796071282007398', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113796089869819845" label="113796089869819845">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113796089869819845', 'user_id': '111303763980604253', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Damn.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:42:09', 'in_reply_to_id': '113796071282007398', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113796130763639672" label="113796130763639672">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113796130763639672', 'user_id': '109276007211588752', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; FuuuUUUUuuck. The entire east side of Laurel Canyon Boulevard, which includes the Canyon Country Store, WC Fields\'s old house, Houdini\'s old estate, countless cultural treasures, are now in the Sunset Fire mandatory evacuation zone. And our old apartment is in the very bottom left corner of that red area.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:52:34', 'in_reply_to_id': '113796071282007398', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113796245024946335" label="113796245024946335">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113796245024946335', 'user_id': '109276007211588752', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Wow. The evacuation is bounded by Laurel Canyon, Hollywood Blvd, Mulholland Blvd., and the 101.&lt;/p&gt;&lt;p&gt;And a fire anywhere in Laurel Canyon will jump that narrow windy road. As goes the Canyon, so goes the Sunset Strip. Chateau Marmont. Maybe Beverly Hills. &lt;/p&gt;&lt;p&gt;Maybe Trump will start caring about climate change if the Playboy Mansion burns.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 03:21:38', 'in_reply_to_id': '113796130763639672', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113796251995844771" label="113796251995844771">
