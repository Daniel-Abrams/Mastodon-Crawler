        <attvalues>
          <attvalue for="0" value="{'id': '114144062176841713', 'user_id': '110556306817546253', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://kolektiva.social/@DoomsdaysCW&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;DoomsdaysCW&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; she still hasn\'t answered for the Graphic Packaging incident that impacted air quality in Kalamazoo&lt;/p&gt;', 'tags': [], 'created_at': '2025-03-11 13:35:51', 'in_reply_to_id': '113653977309400523', 'reblog': None}" />
