        <attvalues>
          <attvalue for="0" value="{'id': '113790875185040746', 'user_id': '109999119965425489', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://epsilon-ix.masto.host/@fuzzface&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;fuzzface&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;/p&gt;&lt;p&gt;then there&amp;#39;s random guy on the street interviewed about the stopped cars, expressing his frustration with them&lt;/p&gt;&lt;p&gt;whom the reporter did not recognize&lt;/p&gt;&lt;p&gt;1980s movie star Steve Guttenberg&lt;/p&gt;&lt;p&gt;(Cocoon, Police Academy, Three Men and a Baby, Diner, Short Circuit, etc)&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://ktla.com/entertainment/actor-steve-guttenberg-helping-fire-crews-by-moving-cars-near-pacific-palisades-brush-fire/&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;ktla.com/entertainment/actor-s&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;teve-guttenberg-helping-fire-crews-by-moving-cars-near-pacific-palisades-brush-fire/&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://mastodon.social/tags/Palisades&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Palisades&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Wildfires&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Wildfires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/LosAngeles&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;LosAngeles&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Fire&quot; class=&quot