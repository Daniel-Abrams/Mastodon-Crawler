      <node id="113812219818813590" label="113812219818813590">
        <viz:color r="30" g="180" b="90" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113812219818813590', 'user_id': '109824850164971498', 'content': '&lt;p&gt;Well that didn\'t take long.  I\'m organizing a small group of volunteers willing to rake Warren Davidson\'s face.&lt;/p&gt;&lt;p&gt;Republican congressman calls for halting of disaster relief to California&lt;br&gt;&lt;a href=&quot;https://www.theguardian.com/us-news/2025/jan/11/warren-davidson-republican-disaster-relief-california-wildfires&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;theguardian.com/us-news/2025/j&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;an/11/warren-davidson-republican-disaster-relief-california-wildfires&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://mstdn.social/tags/WarrenDavidson&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WarrenDavidson&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/GOP&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;GOP&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/Ohio&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Ohio&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/CAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CAFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/WildFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WildFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/ClimateChange&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&