      <node id="113800971627251759" label="113800971627251759">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113800971627251759', 'user_id': '111881428355228293', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; from Agoura Road just past Reyes Adobe, daughter just left there. And people fill your gas tanks before emergency!! She said there are lines at gas stations.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 23:23:41', 'in_reply_to_id': '113800964803574808', 'reblog': None}" />
