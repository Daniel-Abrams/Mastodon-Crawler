      <node id="113808142970501273" label="113808142970501273">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113808142970501273', 'user_id': '109398195072004331', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://partyon.xyz/@nullagent&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;nullagent&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Just imagine the drone penetrated the wing (where fuel is often stored in planes) and the battery caught fire…. Add a plane crash to a forest fire.  Geniuses.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-11 05:47:23', 'in_reply_to_id': '113806660505484813', 'reblog': None}" />
