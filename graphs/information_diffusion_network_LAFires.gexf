        </attvalues>
      </node>
      <node id="113793103142096205" label="113793103142096205">
        <viz:color r="135" g="135" b="120" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793103142096205', 'user_id': '109321601315889133', 'content': '&lt;p&gt;Current, rapidly changing evacuation zones for Eaton Fire in Altadena, La Canada Flintridge, Pasadena. Almost everything north of the 210 is now in some sort of evacuation warning/order. &lt;a href=&quot;https://protect.genasys.com/search?z=11&amp;amp;latlon=34.1746362629392%2C-118.12252644371335&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;protect.genasys.com/search?z=1&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;1&amp;amp;latlon=34.1746362629392%2C-118.12252644371335&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/EatonFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;EatonFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/Pasadena&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Pasadena&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/Altadena&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Altadena&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/LaCanadaFlintridge&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LaCanadaFlintridge&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['EatonFire', 'Altadena'], 'created_at': '2025-01-08 14:02:35', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793128901185335" label="113793128901185335">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793128901185335', 'user_id': '109367280742814706', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; oh God.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 14:09:04', 'in_reply_to_id': '113793103142096205', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793181653494759" label="113793181653494759">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793181653494759', 'user_id': '109294201195034355', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; That changed fast.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 14:22:32', 'in_reply_to_id': '113793103142096205', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793948801344103" label="113793948801344103">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793948801344103', 'user_id': '109948963947983998', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Where are people supposed to evacuate to? I’m in S Pasadena. Which direction is good?&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 17:37:41', 'in_reply_to_id': '113793103142096205', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113794051990859240" label="113794051990859240">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113794051990859240', 'user_id': '109321601315889133', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.social/@riogreyhound&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;riogreyhound&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Not Glendale, for sure. Away from the hills and not southwest of any current fires.  I might say going East would make sense -- towards the casino/Palm Springs side, although the winds will be fierce that way, no wildfire danger. Maybe no power though.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 18:03:53', 'in_reply_to_id': '113793948801344103', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113794094960473001" label="113794094960473001">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113794094960473001', 'user_id': '109948963947983998', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; How about south, like Long Beach?&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 18:14:51', 'in_reply_to_id': '113794051990859240', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113794083773591727" label="113794083773591727">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113794083773591727', 'user_id': '108209993019225688', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.social/@riogreyhound&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;riogreyhound&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;/p&gt;&lt;p&gt;i dont know if this information helps, but good luck to you!&lt;/p&gt;&lt;p&gt;from calfire, re: evacuation shelters for Palisades fire&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 18:11:59', 'in_reply_to_id': '113793948801344103', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113794227272671623" label="113794227272671623">
