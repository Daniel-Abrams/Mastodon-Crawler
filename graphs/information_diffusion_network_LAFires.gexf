      <node id="113801041013226492" label="113801041013226492">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113801041013226492', 'user_id': '110425104122915406', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://flipboard.com/@AssociatedPress&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;AssociatedPress&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; photographers are bearing witness to the devastation caused by fires ripping through Los Angeles and its surrounding areas. Here are some of the images they captured: Neighborhoods recognizable from above only by the outlines of the streets, charred timbers and rubble, and plumes of smoke everywhere.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://flip.it/irzL4I&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;flip.it/irzL4I&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://flipboard.social/tags/Photography&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Photography&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://flipboard.social/tags/Photos&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Photos&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://flipboard.social/tags/News&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;News&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://flipboard.social/tags/Photojournalism&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Photojournalism&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://flipboard.social/tags/LosAngelesFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LosAngelesFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://flipboard.social/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['losangelesfires', 'LAFires'], 'created_at': '2025-01-09 23:41:10', 'in_reply_to_id': None, 'reblog': None}" />
