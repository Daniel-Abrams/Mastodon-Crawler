      <node id="113788895739415074" label="113788895739415074">
        <viz:color r="0" g="128" b="128" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113788895739415074', 'user_id': '109362752019399380', 'content': '&lt;p&gt;First of my multiple (short) livestreams over the next 24 hours will begin around 12:30pm PT. Will discuss worsening wind and wildfire conditions, including dangerous/fast-spreading &lt;a href=&quot;https://mastodon.social/tags/PalisadesFire&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;PalisadesFire&lt;/span&gt;&lt;/a&gt;. &lt;a href=&quot;https://mastodon.social/tags/CAwx&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;CAwx&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/CAfire&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;CAfire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://youtube.com/live/z3Y0pHvp-YY?feature=share&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;youtube.com/live/z3Y0pHvp-YY?f&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;eature=share&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['palisadesfire'], 'created_at': '2025-01-07 20:12:37', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
