          <attvalue for="0" value="{'id': '113837540937996400', 'user_id': '109334374718728328', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://climatejustice.social/@marion_grau&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;marion_grau&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; I’m not familiar with that but I will check it out! Sounds like something I would be interested in.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-16 10:23:41', 'in_reply_to_id': '113836179321478697', 'reblog': None}" />
        </attvalues>
      </node>
