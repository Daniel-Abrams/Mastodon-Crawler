      <node id="113807393618540777" label="113807393618540777">
        <viz:color r="30" g="180" b="90" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113807393618540777', 'user_id': '109259831124761671', 'content': '&lt;p&gt;I donated to World Central Kitchen today. It&amp;#39;s not much, but every little bit helps. If you are looking for a way to help California or any area around the world, this is a wonderful organization that is helping in a real way that is immediate and visible. &lt;a href=&quot;https://wck.org/&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;wck.org/&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt;&lt;br /&gt;&lt;a href=&quot;https://mastodon.social/tags/WCK&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;WCK&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/CaliforniaFires&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;CaliforniaFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Donations&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Donations&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['Californiafires'], 'created_at': '2025-01-11 02:36:52', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
