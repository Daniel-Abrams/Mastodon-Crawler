      <node id="113793426186239073" label="113793426186239073">
        <viz:color r="105" g="110" b="121" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793426186239073', 'user_id': '109734730655443810', 'content': '&lt;p&gt;If you have friends or family in the path of the LA fires like I do - the best app I’ve found so far to track the latest info is “Watch Duty.” Also “Genasys Protect” is supposed to be good but it wasn’t working for me this morning. The house icon is where I’ve programmed in a specific address for the app to watch. &lt;a href=&quot;https://mastodon.hams.social/tags/LAfire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAfire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/PalisadesFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;PalisadesFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/hurstfire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;hurstfire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/WoodleyFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WoodleyFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/EatonFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;EatonFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/TeresaFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TeresaFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/KingFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;KingFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/CaliforniaFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CaliforniaFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/CaliforniaFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CaliforniaFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.hams.social/tags/LAfires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAfires&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire', 'palisadesfire', 'hurstfire', 'woodleyfire', 'EatonFire', 'Californiafire', 'Californiafires', 'LAFires'], 'created_at': '2025-01-08 15:24:38', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793437617394447" label="113793437617394447">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793437617394447', 'user_id': '109294201195034355', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.hams.social/@KE0FFT&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;KE0FFT&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Dang. So close to where my daughter lives too. Guess we\'ll both be WatchDuty bird-dogging this today.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 15:27:32', 'in_reply_to_id': '113793426186239073', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793625362510717" label="113793625362510717">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793625362510717', 'user_id': '109524660450685406', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.hams.social/@KE0FFT&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;KE0FFT&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; If you aren’t following him already, &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; is involved with WatchDuty and also posts about fires.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 16:15:25', 'in_reply_to_id': '113793426186239073', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793887624984873" label="113793887624984873">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793887624984873', 'user_id': '109298991424819184', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.hams.social/@KE0FFT&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;KE0FFT&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; love Watch Duty. It’s free. You get a few extra bells and whistles if you subscribe. I subscribed, mostly to support dev and maintenance.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 17:22:07', 'in_reply_to_id': '113793426186239073', 'reblog': None}" />
        </attvalues>
      </node>
