      <node id="113795847266948564" label="113795847266948564">
        <viz:color r="135" g="135" b="120" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113795847266948564', 'user_id': '109241377377987039', 'content': '&lt;p&gt;My wife&amp;#39;s brother and his wife lost everything to the Eaton fire today in Altadena, CA.&lt;/p&gt;&lt;p&gt;I&amp;#39;ve just started this GoFundMe with their blessing, to help them raise money to find a new place and begin to rebuild their belongings.&lt;/p&gt;&lt;p&gt;Any help appreciated, even boosts. Thanks! &lt;a href=&quot;https://mastodon.social/tags/EatonFire&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;EatonFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Altadena&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Altadena&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/fire&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;fire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/gofundme&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;gofundme&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/disaster&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;disaster&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://www.gofundme.com/f/help-michael-brooke-rebuild-after-fire&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;gofundme.com/f/help-michael-br&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;ooke-rebuild-after-fire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['EatonFire', 'Altadena'], 'created_at': '2025-01-09 01:40:29', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113799262852613057" label="113799262852613057">
        <viz:color r="135" g="135" b="120" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113799262852613057', 'user_id': '109241377377987039', 'content': '&lt;p&gt;Composite satellite photo of Altadena. I marked my brother-in-law&amp;#39;s house with the arrow. 😮 &lt;a href=&quot;https://mastodon.social/tags/EatonFire&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;EatonFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Altadena&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Altadena&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/fire&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;fire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/gofundme&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;gofundme&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/mutualaid&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;mutualaid&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://www.gofundme.com/f/help-michael-brooke-rebuild-after-fire&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;gofundme.com/f/help-michael-br&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;ooke-rebuild-after-fire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['EatonFire', 'Altadena'], 'created_at': '2025-01-09 16:09:07', 'in_reply_to_id': '113795847266948564', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113795967309159734" label="113795967309159734">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113795967309159734', 'user_id': '113455965898459323', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.social/@The_Tim&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;The_Tim&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; I am so sorry&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:11:01', 'in_reply_to_id': '113795847266948564', 'reblog': None}" />
        </attvalues>
