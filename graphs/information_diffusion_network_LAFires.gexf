        <attvalues>
          <attvalue for="0" value="{'id': '113794443484823212', 'user_id': '113518828309556459', 'content': '', 'tags': [], 'created_at': '2025-01-08 19:43:27', 'in_reply_to_id': None, 'reblog': '113794407739825297'}" />
