      <node id="113794118643880705" label="113794118643880705">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113794118643880705', 'user_id': '109396635895543644', 'content': '&lt;p&gt;Our JPL director Dr Laurie Leshin reporting that “No fire damage so far (some wind damage) but it is very close to the lab.” 🥺&lt;br&gt;Hoping it stays mostly unaffected. &lt;br&gt;&lt;a href=&quot;https://masto.ai/tags/LAfires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAfires&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-08 18:20:51', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
