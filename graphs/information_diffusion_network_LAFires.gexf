        <attvalues>
          <attvalue for="0" value="{'id': '113796686729200628', 'user_id': '109321601315889133', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://wandering.shop/@cavyherd&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;cavyherd&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Everytime I am up there I cringe&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 05:13:57', 'in_reply_to_id': '113796638133985370', 'reblog': None}" />
