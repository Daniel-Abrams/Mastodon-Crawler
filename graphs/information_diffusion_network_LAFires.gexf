        <attvalues>
          <attvalue for="0" value="{'id': '113796251995844771', 'user_id': '112112233954551289', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://c.im/@msbellows&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;msbellows&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; only enough to blame CA for not taking its forests enough&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 03:23:24', 'in_reply_to_id': '113796245024946335', 'reblog': None}" />
        </attvalues>
      </node>
