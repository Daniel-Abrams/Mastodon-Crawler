        <attvalues>
          <attvalue for="0" value="{'id': '113795255833438943', 'user_id': '110272050577634525', 'content': '', 'tags': [], 'created_at': '2025-01-08 23:10:04', 'in_reply_to_id': None, 'reblog': '113795254456462927'}" />
