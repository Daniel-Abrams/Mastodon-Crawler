      <node id="109525864855750436" label="109525864855750436">
        <viz:color r="30" g="180" b="90" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '109525864855750436', 'user_id': '109332814399981582', 'content': '&lt;p&gt;Albuquerque, the home of 10Tanker and yearly maintenance of the 4 very large air tankers (&lt;a href=&quot;https://newsie.social/tags/VLAT&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;VLAT&lt;/span&gt;&lt;/a&gt;) welcomes home one of these special DC-10 birds …here comes T914 in for the touch down on runway for annual &lt;a href=&quot;https://newsie.social/tags/maintenance&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;maintenance&lt;/span&gt;&lt;/a&gt;…&lt;br&gt;&lt;a href=&quot;https://newsie.social/tags/10_tanker&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;10_tanker&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/Readytoserve&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Readytoserve&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/avgeek&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;avgeek&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/aviationdaily&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;aviationdaily&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/dc10lovers&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;dc10lovers&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/aviationphotography&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;aviationphotography&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/planespotter&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;planespotter&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/cawx&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;cawx&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/wildfires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;wildfires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/airtankers&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;airtankers&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/CaliforniaWildFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CaliforniaWildFires&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['CaliforniaWildfires'], 'created_at': '2022-12-16 23:07:29', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
