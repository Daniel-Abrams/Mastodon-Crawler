        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113794468819773717', 'user_id': '109290489834621559', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://masto.ai/@astroptere&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;astroptere&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; 🤞&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 19:49:54', 'in_reply_to_id': '113794118643880705', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113799537890909150" label="113799537890909150">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113799537890909150', 'user_id': '109241173876812454', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://masto.ai/@astroptere&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;astroptere&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; apparently in 2009, a wildfire came within 3 feet of destroying JPL. Aerospace can do a lot - SAR early detection, drone or flight early detection, flight sea-water collection. I don’t see a single mission at JPL focused on wildfires, but if wildfires almost destroyed the lab in 2009, why wouldn’t there be several missions working on this?&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 17:19:04', 'in_reply_to_id': '113794118643880705', 'reblog': None}" />
        </attvalues>
      </node>
