      <node id="113828567717985896" label="113828567717985896">
        <viz:color r="120" g="139" b="79" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113828567717985896', 'user_id': '109707333828707588', 'content': '&lt;p&gt;If you live or work in an area affected by the fires, you can ask your loan servicer to pause or reduce your loan payments for up to 90 days through a natural disaster forbearance. &lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://hellions.cloud/tags/AltaDenaFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;AltaDenaFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://hellions.cloud/tags/PalisadesFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;PalisadesFire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;What to do with student loans if you\'ve been impacted by L.A.-area fires &lt;a href=&quot;https://www.axios.com/2025/01/14/student-loans-wildfires-los-angeles&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;axios.com/2025/01/14/student-l&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;oans-wildfires-los-angeles&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['Altadenafire', 'palisadesfire'], 'created_at': '2025-01-14 20:21:39', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
