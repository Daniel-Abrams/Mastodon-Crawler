        <attvalues>
          <attvalue for="0" value="{'id': '113796229847910853', 'user_id': '109270836356361372', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://romancelandia.club/@herhandsmyhands&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;herhandsmyhands&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;br&gt;On the other hand, renowned actor James Woods, who has no training in climate science that I’m aware of, assures us that climate change has nothing to do with it and that the actual cause is liberal politicians.&lt;/p&gt;&lt;p&gt;So obviously mainstream media’s hands are tied. 🙄&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 03:17:42', 'in_reply_to_id': '113794992506153345', 'reblog': None}" />
