        <attvalues>
          <attvalue for="0" value="{'id': '113304109073222790', 'user_id': '109452650553238887', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;br&gt;... not only the US is becoming too hot 🔥...&lt;/p&gt;', 'tags': [], 'created_at': '2024-10-14 05:24:59', 'in_reply_to_id': '113303748825336874', 'reblog': None}" />
