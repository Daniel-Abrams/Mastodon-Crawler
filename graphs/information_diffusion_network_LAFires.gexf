        <attvalues>
          <attvalue for="0" value="{'id': '113800029925327780', 'user_id': '112786614683594225', 'content': '&lt;p&gt;Please help &lt;a href=&quot;https://mastodon.social/tags/boost&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;boost&lt;/span&gt;&lt;/a&gt;&lt;br /&gt;&lt;a href=&quot;https://mastodon.social/tags/LAfires&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;LAfires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/LAwildfires&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;LAwildfires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/catsofmastodon&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;catsofmastodon&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/dogsofmastodon&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;dogsofmastodon&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/animalrescue&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;animalrescue&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/SoCal&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;SoCal&lt;/span&gt;&lt;/a&gt; &lt;/p&gt;&lt;p&gt;Emergency board &lt;a href=&quot;https://mastodon.social/tags/pets&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;pets&lt;/span&gt;&lt;/a&gt;&lt;br /&gt;spcaLA 5026 W. Jefferson Blvd, LA&lt;/p&gt;&lt;p&gt;Foster a pet for a week? foster@pasadenahumane.org or go to Pasadena Humane&lt;/p&gt;&lt;p&gt;Take large &lt;a href=&quot;https://mastodon.social/tags/animals&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;animals&lt;/span&gt;&lt;/a&gt; to LA Equestrian Center 480 Riverside Dr, Burbank&lt;/p&gt;&lt;p&gt;If you find injured wildlife text 626-344-1129, pets call 626-792-7151 x970&lt;/p&gt;&lt;p&gt;Donate $&lt;br /&gt;pasadenahumane.org&lt;/p&gt;&lt;p&gt;Bring food, water bowls, x-lg crates, litter, blankets to shelter 361 S Raymond Ave, Pasadena&lt;/p&gt;', 'tags': ['LAFires', 'LAWildfires'], 'created_at': '2025-01-09 19:24:11', 'in_reply_to_id': None, 'reblog': None}" />
