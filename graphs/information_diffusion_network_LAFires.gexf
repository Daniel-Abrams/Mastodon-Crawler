          <attvalue for="0" value="{'id': '113796170747704122', 'user_id': '110693601999419347', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.sdf.org/@argv_minus_one&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;argv_minus_one&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;br&gt;But the packages said the building materials are inflammable!&lt;/p&gt;&lt;p&gt;What do you mean that\'s not the opposite of flammable?&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 03:02:45', 'in_reply_to_id': '113796133008554314', 'reblog': None}" />
