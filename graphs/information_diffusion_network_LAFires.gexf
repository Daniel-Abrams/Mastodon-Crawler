      <node id="113797463284592918" label="113797463284592918">
        <viz:color r="30" g="180" b="90" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797463284592918', 'user_id': '108193471567690291', 'content': '&lt;p&gt;Schaut Ihr auch auf die &lt;a href=&quot;https://climatejustice.social/tags/CaliforniaWildfires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CaliforniaWildfires&lt;/span&gt;&lt;/a&gt;, und überlegt Euch, wie *Ihr* zusammen mit anderen in so einer Situation reagieren würdet?&lt;/p&gt;&lt;p&gt;Merkt Ihr dann auch, dass ihr keine katastrophenrelevanten Skills habt, und wollt die lernen?&lt;/p&gt;&lt;p&gt;Kommt zum Kollapscamp!&lt;br&gt;kollapscamp.de&lt;/p&gt;', 'tags': ['CaliforniaWildfires'], 'created_at': '2025-01-09 08:31:14', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113797490846759082" label="113797490846759082">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797490846759082', 'user_id': '110348802001581209', 'content': '&lt;p&gt;&lt;a href=&quot;https://climatejustice.social/@muellertadzio&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@muellertadzio@climatejustice.social&lt;/a&gt; Leider zu weit weg 😢&lt;span&gt;&lt;br&gt;&lt;br&gt;Als Feuerwehrmann sind aber zum Glück ein paar Skills vorhanden.&lt;br&gt;&lt;br&gt;Gibt es Talks, die aufgezeichnet werden?&lt;/span&gt;&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 08:38:27', 'in_reply_to_id': '113797463284592918', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113797502780321414" label="113797502780321414">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797502780321414', 'user_id': '108193471567690291', 'content': '&lt;p&gt;bisher denken wir weniger an talks, und mehr an workshops, die u.a, von menschen wie dir angeboten werden :)&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 08:41:24', 'in_reply_to_id': '113797490846759082', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113797532524453921" label="113797532524453921">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797532524453921', 'user_id': '110348802001581209', 'content': '&lt;p&gt;&lt;a href=&quot;https://climatejustice.social/@muellertadzio&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@muellertadzio@climatejustice.social&lt;/a&gt; Ja, das macht sinn. Wenn ihr das mal in Richtung Rhein-Main macht, bin ich gerne dabei! 😉&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 08:49:03', 'in_reply_to_id': '113797502780321414', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113797552214913920" label="113797552214913920">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797552214913920', 'user_id': '109199673314992451', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://climatejustice.social/@muellertadzio&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;muellertadzio&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;br&gt;wenn was passiert werde ich mitten drin sein ... bin halt in der FFW &lt;/p&gt;&lt;p&gt;aber wir können auch ohne strom ein paar tage auskommen. &lt;br&gt;haben da schon vorgesorgt. &lt;/p&gt;&lt;p&gt;wir bräuchen noch Balkon solar und ein paar kW-akku leistung. &lt;/p&gt;&lt;p&gt;das problem wird sein, die meisten haben keinen schimmer was es heist wenn kein strom da ist. und gesellschaftlich sind wir sehr weit auseinander. &lt;/p&gt;&lt;p&gt;ich merke das ja immer wieder wenn selbst unterwegs bin mit der FFW, wie die leute mit einander umgehen&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 08:54:04', 'in_reply_to_id': '113797463284592918', 'reblog': None}" />
        </attvalues>
      </node>
