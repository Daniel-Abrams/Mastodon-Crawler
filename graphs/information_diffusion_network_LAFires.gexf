        <attvalues>
          <attvalue for="0" value="{'id': '113805906135120254', 'user_id': '109289234615814569', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://sfba.social/@sfbaykeeper&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;sfbaykeeper&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://techhub.social/@shantini&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;shantini&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://sfba.social/@jarosenfield&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;jarosenfield&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Trump has never let objective reality get in the way of a good hate-the-Democrats narrative.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-10 20:18:35', 'in_reply_to_id': '113804962342695561', 'reblog': None}" />
