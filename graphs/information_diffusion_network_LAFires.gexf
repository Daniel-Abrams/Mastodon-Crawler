      <node id="113800266519694901" label="113800266519694901">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113800266519694901', 'user_id': '108196165431161469', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://partyon.xyz/@nullagent&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;nullagent&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; are you fucking kidding me? glad to know our priorities are straight in this country, jfc&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 20:24:14', 'in_reply_to_id': '113800261629356965', 'reblog': None}" />
