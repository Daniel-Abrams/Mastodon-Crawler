      <node id="113818325512436185" label="113818325512436185">
        <viz:color r="240" g="150" b="30" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113818325512436185', 'user_id': '109324975437323757', 'content': '&lt;p&gt;A friend of mine in LA wrote some words about the fires that I thought worth amplifying by quoting him and wrapping a brief essay around it to underscore.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://netsettlement.blogspot.com/2025/01/parallel-universes.html&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;netsettlement.blogspot.com/202&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;5/01/parallel-universes.html&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://climatejustice.social/tags/climate&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;climate&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://climatejustice.social/tags/AltadenaFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;AltadenaFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://climatejustice.social/tags/fire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;fire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://climatejustice.social/tags/wildfires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;wildfires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://climatejustice.social/tags/ClimateDenial&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateDenial&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://climatejustice.social/tags/collapse&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;collapse&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://climatejustice.social/tags/ClimateCrisis&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateCrisis&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://climatejustice.social/tags/ClimateEmergency&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateEmergency&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['Altadenafire'], 'created_at': '2025-01-13 00:56:56', 'in_reply_to_id': None, 'reblog': None}" />
