        <attvalues>
          <attvalue for="0" value="{'id': '113796133008554314', 'user_id': '113064048258640535', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;/p&gt;&lt;p&gt;I thought modern cities were fire resistant. What a horrible way to be proven wrong…&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:53:09', 'in_reply_to_id': '113796071282007398', 'reblog': None}" />
