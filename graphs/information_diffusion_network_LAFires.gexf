        <attvalues>
          <attvalue for="0" value="{'id': '113795957874234675', 'user_id': '113507909259827294', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; christ there\'s a lot of homes there!&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:08:37', 'in_reply_to_id': '113795952425505531', 'reblog': None}" />
        </attvalues>
