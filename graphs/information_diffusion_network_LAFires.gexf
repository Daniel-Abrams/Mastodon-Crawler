      <node id="113801018921919751" label="113801018921919751">
        <viz:color r="226" g="88" b="34" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113801018921919751', 'user_id': '109362752019399380', 'content': '&lt;p&gt;Unfortunately a new, wind-driven fire (mainly burning in grass and brush) to report: &lt;a href=&quot;https://mastodon.social/tags/KennethFire&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;KennethFire&lt;/span&gt;&lt;/a&gt;, headed for LA/Ventura County like. Oak Park and surrounding communities at risk as wind pushes this fire quickly to west and south under continued Red Flag Warning. &lt;a href=&quot;https://mastodon.social/tags/CAwx&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;CAwx&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/CAfire&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;CAfire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['kennethfire'], 'created_at': '2025-01-09 23:35:42', 'in_reply_to_id': None, 'reblog': None}" />
