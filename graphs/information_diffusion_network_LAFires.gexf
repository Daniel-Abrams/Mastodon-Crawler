      <node id="113797732373906737" label="113797732373906737">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797732373906737', 'user_id': '108193471567690291', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://climatejustice.social/@KarlHeinzHasliP&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;KarlHeinzHasliP&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; mach ich, obwohl das eigentlich noch gar nicht so richtig geht - you\'ll see 😘&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 09:39:46', 'in_reply_to_id': '113797643087471391', 'reblog': None}" />
