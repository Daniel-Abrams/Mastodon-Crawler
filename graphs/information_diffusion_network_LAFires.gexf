      <node id="113795961280761806" label="113795961280761806">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113795961280761806', 'user_id': '109321601315889133', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://masto.nu/@vwdasher&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;vwdasher&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Nightmare location for sure, but at least winds are calmer.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:09:28', 'in_reply_to_id': '113795957874234675', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113795969849666301" label="113795969849666301">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113795969849666301', 'user_id': '113507909259827294', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; and a lot of fuel, racing up that hillside. I hope no one was up there walking around.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:11:39', 'in_reply_to_id': '113795961280761806', 'reblog': None}" />
        </attvalues>
      </node>
