      <node id="113793517453405978" label="113793517453405978">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793517453405978', 'user_id': '109444651036446045', 'content': '&lt;p&gt;LA Mayor Karen Bass recently pushed for and won a budget where LA Fire Department saw it\'s budget cut by $17M.&lt;/p&gt;&lt;p&gt;Meanwhile the LA police budget was increased by $138M.&lt;/p&gt;&lt;p&gt;Maybe cutting the fire department\'s budget to continue over funding the pigs was a bad idea.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/KarenBass&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;KarenBass&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/ACAB&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ACAB&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-08 15:47:56', 'in_reply_to_id': '113793498031375375', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113790891022232000" label="113790891022232000">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113790891022232000', 'user_id': '109444651036446045', 'content': '&lt;p&gt;LA fire fighters reluctantly join war on cars, bulldoze through a sea of abandoned cars to approach the winter wild fire.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/CA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/WarOnCars&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WarOnCars&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/CarDozer&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CarDozer&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 04:39:59', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113791688714993404" label="113791688714993404">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113791688714993404', 'user_id': '109444651036446045', 'content': '&lt;p&gt;This fire has been growing rapidly and threatens expanding into Santa Monica over night.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/SantaMonica&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SantaMonica&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-08 08:02:51', 'in_reply_to_id': '113790891022232000', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113791693689575788" label="113791693689575788">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113791693689575788', 'user_id': '109444651036446045', 'content': &quot;&lt;p&gt;Fire fighters indicate that the LA fire started in a single family backyard and spread due to heavy winds.&lt;/p&gt;&lt;p&gt;I've seen some online disinformation blaming the homeless, hope this settles it.&lt;/p&gt;&quot;, 'tags': [], 'created_at': '2025-01-08 08:04:08', 'in_reply_to_id': '113791688714993404', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793454657667112" label="113793454657667112">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793454657667112', 'user_id': '109444651036446045', 'content': '&lt;p&gt;Social media posts show the fire rapidly spreading through Malibu yesterday. Numerous electrical arcs were also documented potentially starting additional fires.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 15:31:58', 'in_reply_to_id': '113791693689575788', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793459312398692" label="113793459312398692">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793459312398692', 'user_id': '109444651036446045', 'content': '&lt;p&gt;The Getty Villa grounds were seen on fire and it\'s unclear how bad the damage got.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://www.latimes.com/california/story/2025-01-07/getty-villa-museum-catching-fire-lafd-says&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;latimes.com/california/story/2&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;025-01-07/getty-villa-museum-catching-fire-lafd-says&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/Getty&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Getty&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-08 15:33:09', 'in_reply_to_id': '113793454657667112', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793498031375375" label="113793498031375375">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793498031375375', 'user_id': '109444651036446045', 'content': '&lt;p&gt;Overnight real estate developers began pointing fingers at LA fire department for allegedly running out of water.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-08 15:42:58', 'in_reply_to_id': '113793459312398692', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793900070280484" label="113793900070280484">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793900070280484', 'user_id': '109444651036446045', 'content': '&lt;p&gt;This is clearly an absolute disaster and I hope people got out safely.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 17:25:13', 'in_reply_to_id': '113793517453405978', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793965851591231" label="113793965851591231">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793965851591231', 'user_id': '109444651036446045', 'content': '&lt;p&gt;The fires spread so fast that tons of people never knew there was a wildfire until it had gotten to them.&lt;/p&gt;&lt;p&gt;This clip has been circling the socials, and shows a person in their home surrounded by fire and smoke.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 17:41:57', 'in_reply_to_id': '113793900070280484', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793974999679938" label="113793974999679938">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793974999679938', 'user_id': '109444651036446045', 'content': '&lt;p&gt;Actor Mike Rowe described thinking the smoke was ocean fog, only to quickly find out a friend had lost everything to the fire already.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/MikeRowe&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MikeRowe&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-08 17:44:17', 'in_reply_to_id': '113793965851591231', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113794010126581368" label="113794010126581368">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113794010126581368', 'user_id': '109444651036446045', 'content': '&lt;p&gt;I should point out if you don\'t know, Mike Rowe is a bit of a climate change denier. This sucks to see people suffering the collective devasting outcomes of fossil fuel triggered climate change but it is a bit nice to know the rich and famous deniers are feeling the brunt of it today.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://mikerowe.com/2022/06/off-the-way-fossil-fuel/&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;mikerowe.com/2022/06/off-the-w&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;ay-fossil-fuel/&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/MikeRowe&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MikeRowe&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/ClimateChange&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateChange&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 17:53:14', 'in_reply_to_id': '113793974999679938', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113798109428038048" label="113798109428038048">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113798109428038048', 'user_id': '109444651036446045', 'content': '&lt;p&gt;Overnight an evacuation order was in place in the Runyon Canyon area. This covers part of the iconic Hollywood Boulevard.&lt;/p&gt;&lt;p&gt;Order covers the areas:&lt;/p&gt;&lt;p&gt;101 FREEWAY TO MULHOLLAND BLVD TO LAUREL CANYON TO HOLLYWOOD BLVD - EVACUATE NOW! SHARE THIS!&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/Evacuation&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Evacuation&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/hollywoodblvd&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;hollywoodblvd&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/Hollywood&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Hollywood&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-09 11:15:43', 'in_reply_to_id': '113794010126581368', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113798132207131316" label="113798132207131316">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113798132207131316', 'user_id': '109444651036446045', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://kolektiva.social/@FilmThePoliceLA&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;FilmThePoliceLA&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; was live in Hollywood a few hours ago with important on the ground evacuation route info. Be sure to give him a follow on the socials if you\'re in the area and need overnight local updates.&lt;/p&gt;&lt;p&gt;This appears to he a new and separate LA fire.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/HollywoodFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;HollywoodFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/Sunset&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Sunset&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-09 11:21:30', 'in_reply_to_id': '113798109428038048', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113798139103235231" label="113798139103235231">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113798139103235231', 'user_id': '109444651036446045', 'content': '&lt;p&gt;If you\'re in LA and need mutual aid support or want to help your local community its a great time to find your local mutual organizers. Here\'s one group I\'ve seen posting timely fire information and aid. They are primarily active on Instagram.&lt;/p&gt;&lt;p&gt;Please share more LA mutual aid groups if you know of any!&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://mutualaidla.org/&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;mutualaidla.org/&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/MutualAid&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MutualAid&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/MutualAidLA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MutualAidLA&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-09 11:23:18', 'in_reply_to_id': '113798132207131316', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113798178460077177" label="113798178460077177">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113798178460077177', 'user_id': '109444651036446045', 'content': '&lt;p&gt;For those of us watching at home trying to understand how the &lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt; grew so quickly, my favorite pilot YouTuber Juan Brown has a great video below from the perspective of a former forest fire fighting pilot.&lt;/p&gt;&lt;p&gt;Jaun mentioned that the high winds (40-70mph) prevented aircraft based fire fighting plus the human encroachment into brush lands evolved to burn regularly amplified the risk.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://youtu.be/gunenpZ5JuE&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;youtu.be/gunenpZ5JuE&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/blancolirio&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;blancolirio&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/JuanBrown&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;JuanBrown&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFire'], 'created_at': '2025-01-09 11:33:18', 'in_reply_to_id': '113798139103235231', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113800261629356965" label="113800261629356965">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113800261629356965', 'user_id': '109444651036446045', 'content': '&lt;p&gt;Mutual Aid activists in Los Angeles this morning reported that homeless sweeps continued this week unabated despite the continuing fires.&lt;/p&gt;&lt;p&gt;If you\'re wealthy and lost your home the city is rolling out the hearts, prayers and demands you\'re compensated by insurance and the government for your loss.&lt;/p&gt;&lt;p&gt;But if you\'re homeless and living on a sidewalk they will come take your tent, expose you to the wild fire smoke and elements.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/Homeless&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Homeless&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/MutualAid&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MutualAid&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/TheWarOnTents&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TheWarOnTents&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-09 20:22:59', 'in_reply_to_id': '113798178460077177', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113801522184838141" label="113801522184838141">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113801522184838141', 'user_id': '109444651036446045', 'content': '&lt;p&gt;LA Fire Chief Kristin Crowley said over amonth ago that the $17.6million budget cut would hamper their ability to respond to large fires. That money was directed to cops instead.&lt;/p&gt;&lt;p&gt;In this segment the fire chief repeats that these budget cuts were real and have real negative impacts in the quality of service they can provide.&lt;/p&gt;&lt;p&gt;Chief Crowley says they did what they could with what they had &amp;amp; suggests it wasn\'t possible to contain this fire at any funding level.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFD&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFD&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/KristinCrowley&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;KristinCrowley&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-10 01:43:37', 'in_reply_to_id': '113800261629356965', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113801705737958043" label="113801705737958043">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113801705737958043', 'user_id': '109444651036446045', 'content': '&lt;p&gt;More to the point, here\'s the receipts on the LA Fire Department\'s budget cuts.&lt;/p&gt;&lt;p&gt;The fire chief wrote a 20+ page report on how the cuts were real and seriously impact their ability to fight big fires. They literally had to cut pilot training hours for airborne fire fighters.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://clkrep.lacity.org/onlinedocs/2024/24-1600_rpt_bfc_12-17-24.pdf&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;clkrep.lacity.org/onlinedocs/2&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;024/24-1600_rpt_bfc_12-17-24.pdf&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFD&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFD&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/KarenBass&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;KarenBass&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/KristinCrowley&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;KristinCrowley&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/acab&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;acab&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-10 02:30:16', 'in_reply_to_id': '113801522184838141', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113801726362634785" label="113801726362634785">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113801726362634785', 'user_id': '109444651036446045', 'content': '&lt;p&gt;I\'m just a citizen loud mouth on mastodon but it\'s kinda amazing how much of the media is calling the budget cut fake news. It is not.&lt;/p&gt;&lt;p&gt;All the media takes such as the BET one below, point to the idea that the budget could be added to at a later date and reason that it wasn\'t a budget cut.&lt;/p&gt;&lt;p&gt;Look, its not even debatable. LAFD\'s budget was CUT by $17M+.&lt;/p&gt;&lt;p&gt;When you take budget and replace it with an IOU that is by definition a budget cut.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://www.bet.com/article/pgykqa/la-mayor-karen-bass-palisades-fire&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;bet.com/article/pgykqa/la-mayo&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;r-karen-bass-palisades-fire&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/KarenBass&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;KarenBass&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/BET&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;BET&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFD&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFD&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-10 02:35:34', 'in_reply_to_id': '113801705737958043', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113805622629538126" label="113805622629538126">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113805622629538126', 'user_id': '109444651036446045', 'content': '&lt;p&gt;This morning LA fire officials indicate that they have become aware of false evacuation orders circulating that appear to come from the official emergency management text warning system. This maybe a cyber security incident but it\'s not know yet exactly how these texts were sent.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/cybersecurity&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;cybersecurity&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFD&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFD&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-10 19:06:24', 'in_reply_to_id': '113801726362634785', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113805896154365691" label="113805896154365691">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113805896154365691', 'user_id': '109444651036446045', 'content': '&lt;p&gt;According to people in LA county this false evacuation order was sent out three times over the last 12-18 hours.&lt;/p&gt;&lt;p&gt;The first two were sent to all residents of LA County and the third was intended to be delivered to residents near the Eaton fire but were instead delivered to everyone in Long Beach instead.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/Disinformation&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Disinformation&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/cybersecurity&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;cybersecurity&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-10 20:15:59', 'in_reply_to_id': '113805622629538126', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113806660505484813" label="113806660505484813">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113806660505484813', 'user_id': '109444651036446045', 'content': '&lt;p&gt;For the love of god people need to stop flying drones near wild fires while aerial fire fighters at work. A fire fighting plane struck a drone and now needs repairs.&lt;/p&gt;&lt;p&gt;The issue obviously being that these planes must fly right down to the deck below the typically allowed 400ft flight ceiling of consumer drones.&lt;/p&gt;&lt;p&gt;Not a wise time to be sharing your drone photos of LA, might get some unwanted attention from the FAA &lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/drone&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;drone&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/la&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;la&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/FAA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FAA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFD&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFD&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-10 23:30:23', 'in_reply_to_id': '113805896154365691', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113807012174571962" label="113807012174571962">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113807012174571962', 'user_id': '109444651036446045', 'content': '&lt;p&gt;LA Fire Chief Crowley is now saying that the budget cuts are actively cutting into their ability to respond to the continuing LA fires.&lt;/p&gt;&lt;p&gt;In a letter a month ago the fire chief warned that the budget cuts would impact maintenance &lt;br&gt;, air crews and slow down onboarding new fire fighters. Cuts which would hamper their ability to respond to extended emergencies just like this one.&lt;/p&gt;&lt;p&gt;Experts and links to that letter from the chief 👇🏿 &lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/@nullagent/113801705345413967&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;partyon.xyz/@nullagent/1138017&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;05345413967&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://partyon.xyz/tags/LA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LA&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://partyon.xyz/tags/ChiefCrowely&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ChiefCrowely&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-11 00:59:49', 'in_reply_to_id': '113806660505484813', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113807255948657135" label="113807255948657135">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113807255948657135', 'user_id': '109444651036446045', 'content': &quot;&lt;p&gt;In remarks on other networks the fire chief says the city failed the fire department. There's also been a lot of rumors and accusations about the fire department running out of water. The chief doesn't have a lot to update on the topic but says they're doing everything they can and acknowledges that some water reservoirs might not have been operational but that's not her department's responsibility.&lt;/p&gt;&quot;, 'tags': [], 'created_at': '2025-01-11 02:01:33', 'in_reply_to_id': '113807012174571962', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113807321870411424" label="113807321870411424">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113807321870411424', 'user_id': '109444651036446045', 'content': &quot;&lt;p&gt;Update: Crowely was summoned to Mayor Bass' office after her critical statements above and reporters were on scene waiting to find out the purpose and outcome of this meeting.&lt;/p&gt;&lt;p&gt;A dailymail article published at the time of the meeting cited unnamed sources in the fire department that the Chief was preparing her staff for the possibility that shes gets fired.&lt;/p&gt;&lt;p&gt;These rumors did not come true and the chief appears to still have a job for now.&lt;/p&gt;&quot;, 'tags': [], 'created_at': '2025-01-11 02:18:36', 'in_reply_to_id': '113807255948657135', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113809819354432174" label="113809819354432174">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113809819354432174', 'user_id': '109444651036446045', 'content': '&lt;p&gt;A lot of the questions about the impact of the LA Fire budget cuts really came to a head this week when footage emerged of a fire fighter using a traffic cone to dose flames&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-11 12:53:43', 'in_reply_to_id': '113807321870411424', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793559771384470" label="113793559771384470">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793559771384470', 'user_id': '113416359445204463', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot;&gt;&lt;a href=&quot;https://partyon.xyz/@nullagent&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;nullagent&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; Just get the cops to shoot the fire dead. Sorry. There should be a officer involved shooting involving the fire.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 15:58:44', 'in_reply_to_id': '113793517453405978', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793908006435039" label="113793908006435039">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793908006435039', 'user_id': '108194890308088987', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://partyon.xyz/@nullagent&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;nullagent&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; 1. I cannot get over how this is JANUARY&lt;br /&gt;2. I don&amp;#39;t think I&amp;#39;d be welcoming to a camera crew as I was running for my life from Climate Fires. &lt;/p&gt;&lt;p&gt;😞&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 17:27:18', 'in_reply_to_id': '113793900070280484', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793908136360601" label="113793908136360601">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113793908136360601', 'user_id': '108234081875814115', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://partyon.xyz/@nullagent&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;nullagent&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; there\'s another layer of disaster, of a journalist on a very risky place, making the people evacuation go slower.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 17:27:19', 'in_reply_to_id': '113793900070280484', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113793983030363582" label="113793983030363582">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
