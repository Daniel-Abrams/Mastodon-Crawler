      <node id="114146451431782937" label="114146451431782937">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '114146451431782937', 'user_id': '110556306817546253', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://kolektiva.social/@DoomsdaysCW&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;DoomsdaysCW&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; oh and this interesting tidbit too&lt;/p&gt;&lt;p&gt;Watch &quot;TELEPORTATION, BRIBED WITNESSES? Wild Story of INNOCENT Man Gretchen Whitmer is Keeping in Prison&quot; on YouTube&lt;br&gt;&lt;a href=&quot;https://youtu.be/jgGyGxmeiY0&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;youtu.be/jgGyGxmeiY0&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': [], 'created_at': '2025-03-11 23:43:43', 'in_reply_to_id': '114144062176841713', 'reblog': None}" />
