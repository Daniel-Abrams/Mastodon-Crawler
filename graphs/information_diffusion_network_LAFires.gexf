        <attvalues>
          <attvalue for="0" value="{'id': '113795975979222087', 'user_id': '108194856164807197', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; yes, I saw him on a fire earlier - sometimes I do miss &lt;a href=&quot;https://sfba.social/tags/firetwitter&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;firetwitter&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:13:12', 'in_reply_to_id': '113795952425505531', 'reblog': None}" />
