      <node id="113796497671409081" label="113796497671409081">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113796497671409081', 'user_id': '108195772307061769', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;I keep seeing streets I used to bike along in the wildfire evacuation zones...&lt;/p&gt;&lt;p&gt;Again: Good luck over there, for whatever it is worth.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 04:25:46', 'in_reply_to_id': '113796071282007398', 'reblog': None}" />
