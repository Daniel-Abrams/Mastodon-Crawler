      <node id="109802060148891081" label="109802060148891081">
        <viz:color r="30" g="180" b="90" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '109802060148891081', 'user_id': '109332814399981582', 'content': '&lt;p&gt;Still honoring Coulson Aviation this morning…contractor for CalFire and the &lt;a href=&quot;https://newsie.social/tags/CaliforniaWildFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CaliforniaWildFires&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/Wildfire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Wildfire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/avgeek&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;avgeek&lt;/span&gt;&lt;/a&gt; Here in Chile…their C130 Hercules, Tanker 131, aircraft is unloading retardant at Nueva Aldea Pulp Mill in Ranquil…she maybe back in California for our Fire season up north…watching this definitely helps calm my anxiety while smiling and supporting these incredible air tanker pilots…&lt;/p&gt;', 'tags': ['CaliforniaWildfires'], 'created_at': '2023-02-03 17:47:46', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
