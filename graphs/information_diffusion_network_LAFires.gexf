          <attvalue for="0" value="{'id': '113801392785125384', 'user_id': '109293576544386045', 'content': '&lt;p&gt;Ethan Swope\'s devastating photo of the devastation in Altadena. Heart breaking. &lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://zirk.us/tags/CaliforniaWildFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CaliforniaWildFires&lt;/span&gt;&lt;/a&gt; &lt;br&gt;&lt;a href=&quot;https://zirk.us/tags/Altadena&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Altadena&lt;/span&gt;&lt;/a&gt; &lt;br&gt;&lt;a href=&quot;https://zirk.us/tags/ClimateChange&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateChange&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['CaliforniaWildfires', 'Altadena'], 'created_at': '2025-01-10 01:10:44', 'in_reply_to_id': None, 'reblog': None}" />
