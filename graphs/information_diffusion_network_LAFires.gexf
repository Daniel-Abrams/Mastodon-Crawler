          <attvalue for="0" value="{'id': '113794282294209939', 'user_id': '1135273', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://partyon.xyz/@nullagent&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;nullagent&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;/p&gt;&lt;p&gt;I&amp;#39;m sure he&amp;#39;ll rationalize a way out of the fact that it&amp;#39;s January, not September.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-08 19:02:30', 'in_reply_to_id': '113794010126581368', 'reblog': None}" />
