      <node id="113797880745146452" label="113797880745146452">
        <viz:color r="15" g="154" b="109" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113797880745146452', 'user_id': '111306111358247151', 'content': '&lt;p&gt;Ce n’est pas l’écologie qui est punitive mais l’inaction climatique mondiale. &lt;br&gt;Ne pas réduire drastiquement les émissions de gaz à effet de serre est un &lt;a href=&quot;https://piaille.fr/tags/CrimeClimatique&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CrimeClimatique&lt;/span&gt;&lt;/a&gt;.&lt;br&gt;&lt;a href=&quot;https://piaille.fr/tags/PalisadesFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;PalisadesFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://piaille.fr/tags/California&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;California&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://piaille.fr/tags/californiafires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;californiafires&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['palisadesfire', 'Californiafires'], 'created_at': '2025-01-09 10:17:35', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
