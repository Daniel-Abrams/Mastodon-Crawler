      <node id="113796007983996166" label="113796007983996166">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113796007983996166', 'user_id': '109350336444079745', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt;  Getting a good view of it from East Hollywood.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:21:20', 'in_reply_to_id': '113795952425505531', 'reblog': None}" />
