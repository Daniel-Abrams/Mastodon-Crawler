      <node id="113801079507820985" label="113801079507820985">
        <viz:color r="226" g="88" b="34" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113801079507820985', 'user_id': '110433002329275149', 'content': '&lt;p&gt;&lt;a href=&quot;https://m.ai6yr.org/tags/KennethFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;KennethFire&lt;/span&gt;&lt;/a&gt; is heading toward Las Virgenes Creek area.&lt;br&gt;Map shows most recent perimeter.&lt;br&gt;This is north of the Palisades fire and on the other side of Highway 101. &lt;/p&gt;&lt;p&gt;Aguora Hills, Oak Park, etc - pay close attention.&lt;/p&gt;&lt;p&gt;Screenshot includes wind forecast from NOAA for a point within the current fire perimeter. 😨 &lt;/p&gt;&lt;p&gt;Open GISsurfer map:&lt;br&gt;&lt;a href=&quot;https://mappingsupport.com/p2/gissurfer.php?center=34.169132,-118.708296&amp;amp;zoom=13&amp;amp;basemap=Open_Topo_Map&amp;amp;overlay=MODIS_7_day,VIIRS_7_day,Lake_river_stream,Fire_camera_location,Perimeter_FIRIS_intel&amp;amp;data=https://mappingsupport.com/p2/special_maps/disaster/USA_wildland_fire.txt&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;mappingsupport.com/p2/gissurfe&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;r.php?center=34.169132,-118.708296&amp;amp;zoom=13&amp;amp;basemap=Open_Topo_Map&amp;amp;overlay=MODIS_7_day,VIIRS_7_day,Lake_river_stream,Fire_camera_location,Perimeter_FIRIS_intel&amp;amp;data=https://mappingsupport.com/p2/special_maps/disaster/USA_wildland_fire.txt&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['kennethfire'], 'created_at': '2025-01-09 23:51:03', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
