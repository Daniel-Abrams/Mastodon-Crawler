      <node id="113795952425505531" label="113795952425505531">
        <viz:color r="226" g="88" b="34" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113795952425505531', 'user_id': '109321601315889133', 'content': '&lt;p&gt;Very fast moving fire in Runyon Canyon/Hollywood. Evacuations already triggered. Thankful that CAFireScanner is at the helm. &lt;a href=&quot;https://m.ai6yr.org/tags/SunsetFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SunsetFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/LosAngeles&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LosAngeles&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/Hollywood&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Hollywood&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/RunyonCanyon&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;RunyonCanyon&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['sunsetfire'], 'created_at': '2025-01-09 02:07:10', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113795955751656538" label="113795955751656538">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113795955751656538', 'user_id': '109367280742814706', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://m.ai6yr.org/@ai6yr&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;ai6yr&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; oh, God.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 02:08:03', 'in_reply_to_id': '113795952425505531', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113795957874234675" label="113795957874234675">
