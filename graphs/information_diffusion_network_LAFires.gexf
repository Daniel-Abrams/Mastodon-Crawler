      <node id="113795017652721716" label="113795017652721716">
        <viz:color r="150" g="50" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113795017652721716', 'user_id': '109253103044770842', 'content': '&lt;p&gt;If you&amp;#39;re watching videos of Los Angeles &lt;a href=&quot;https://mastodon.social/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt; tonight, go and read Fire Weather by John Vaillant. A terrifying look at our future. &lt;a href=&quot;https://mastodon.social/tags/ClimateChange&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;ClimateChange&lt;/span&gt;&lt;/a&gt; &lt;br /&gt;&lt;a href=&quot;https://en.wikipedia.org/wiki/Fire_Weather&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;en.wikipedia.org/wiki/Fire_Wea&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;ther&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-08 22:09:30', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113798314331639181" label="113798314331639181">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113798314331639181', 'user_id': '540996', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.social/@sellathechemist&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;sellathechemist&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; I endorse the recommendation. John Vaillant was on BBC R4 Today this morning &lt;a href=&quot;https://www.bbc.co.uk/sounds/play/m0026ng8&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;&quot;&gt;bbc.co.uk/sounds/play/m0026ng8&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt; from about 2:35.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 12:07:52', 'in_reply_to_id': '113795017652721716', 'reblog': None}" />
        </attvalues>
      </node>
      <node id="113798348533414585" label="113798348533414585">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113798348533414585', 'user_id': '109253103044770842', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mathstodon.xyz/@Martin_Whitworth&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;Martin_Whitworth&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; I worry about the Alpine valleys of my childhood where I just spent a few days. I worry that one of these summers we&amp;#39;ll see some horrors, to add to the flash floods we&amp;#39;ve already had recently.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-09 12:16:35', 'in_reply_to_id': '113798314331639181', 'reblog': None}" />
        </attvalues>
      </node>
