        <attvalues>
          <attvalue for="0" value="{'id': '113796334437837599', 'user_id': '113110106016364414', 'content': '&lt;p&gt;Six fires raging across Los Angeles County&lt;/p&gt;&lt;p&gt;A new fire just broke out in the Hollywood Hills near Sunset Boulevard. Fierce winds are making the blazes hard to contain. &lt;/p&gt;&lt;p&gt;At least 5 dead as thousands evacuate ahead of raging wildfires in Los Angeles area &lt;a href=&quot;https://m.ai6yr.org/tags/wildfire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;wildfire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/LACounty&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LACounty&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/PalisadesFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;PalisadesFire&lt;/span&gt;&lt;/a&gt;  &lt;a href=&quot;https://m.ai6yr.org/tags/HurstFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;HurstFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/EatonFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;EatonFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/WoodleyFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WoodleyFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/LidiaFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LidiaFire&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/SunsetFire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SunsetFire&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://www.cnn.com/weather/live-news/los-angeles-pacific-palisades-eaton-wildfires-01-08-25/index.html&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;cnn.com/weather/live-news/los-&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;angeles-pacific-palisades-eaton-wildfires-01-08-25/index.html&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['palisadesfire', 'hurstfire', 'EatonFire', 'woodleyfire', 'lidiafire', 'sunsetfire'], 'created_at': '2025-01-09 03:44:20', 'in_reply_to_id': None, 'reblog': None}" />
