          <attvalue for="0" value="{'id': '113792943752810063', 'user_id': '109902829147210684', 'content': '&lt;p&gt;While Trump is trolling Canada about annexing it, Canadian Fire Fighters are in Los Angeles tonight dropping water on the fires raging through the county. &lt;a href=&quot;https://mastodon.social/tags/LAFires&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;LAFires&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['LAFires'], 'created_at': '2025-01-08 13:22:05', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
