      <node id="109818820521485955" label="109818820521485955">
        <viz:color r="30" g="180" b="90" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '109818820521485955', 'user_id': '109332814399981582', 'content': '&lt;p&gt;In honor of T139, Coulson’s LAT 737 that went down today while fighting &lt;a href=&quot;https://newsie.social/tags/wildfire&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;wildfire&lt;/span&gt;&lt;/a&gt; (the crew is safe) is a video of on her first air attack in Yosemite Valley. It is hard to explain how this loss hits me when airtankers saved my home during the &lt;a href=&quot;https://newsie.social/tags/CaliforniaWildFires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CaliforniaWildFires&lt;/span&gt;&lt;/a&gt;…she is a live entity to me and will be sorely missed…my condolences to the Coulson aviation family, the crew and their families and of course…to T139 &lt;a href=&quot;https://newsie.social/tags/avgeek&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;avgeek&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://newsie.social/tags/AvgeeksofMastodon&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;AvgeeksofMastodon&lt;/span&gt;&lt;/a&gt;  &lt;a href=&quot;https://newsie.social/tags/avgeeks&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;avgeeks&lt;/span&gt;&lt;/a&gt;  &lt;a href=&quot;https://newsie.social/tags/airtankers&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;airtankers&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'tags': ['CaliforniaWildfires'], 'created_at': '2023-02-06 16:50:09', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
      <node id="109819243600111569" label="109819243600111569">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '109819243600111569', 'user_id': '109308055880859866', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot;&gt;&lt;a href=&quot;https://newsie.social/@Geewhizpat&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;Geewhizpat&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; glad to hear the crew are safe, aircraft can be replaced but people can not&lt;/p&gt;', 'tags': [], 'created_at': '2023-02-06 18:37:51', 'in_reply_to_id': '109818820521485955', 'reblog': None}" />
        </attvalues>
      </node>
