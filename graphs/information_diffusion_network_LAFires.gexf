          <attvalue for="0" value="{'id': '113821523424366833', 'user_id': '111887454356563174', 'content': '&lt;p&gt;&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://toad.social/@KimPerales&quot; class=&quot;u-url mention&quot;&gt;@&lt;span&gt;KimPerales&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;/p&gt;&lt;p&gt;Wait...Trump&amp;#39;s ring is on his ass? Makes sense, I suppose.&lt;/p&gt;', 'tags': [], 'created_at': '2025-01-13 14:30:16', 'in_reply_to_id': '113817773184500035', 'reblog': None}" />
