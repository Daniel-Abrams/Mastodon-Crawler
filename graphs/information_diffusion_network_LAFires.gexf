      <node id="113794615694286302" label="113794615694286302">
        <viz:color r="190" g="190" b="190" a="1.0" />
        <attvalues>
          <attvalue for="0" value="{'id': '113794615694286302', 'user_id': '110272050577634525', 'content': &quot;&lt;p&gt;UPDATE: THANK YOU TO ALL WHO HAVE BOOSTED AND/OR OFFERED ADVICE ON HELPING TO PLACE THESE CATS! THE SITUATION IS FIXED FOR NOW!! NO NEED TO CONTINUE TO BOOST AT THIS TIME!&lt;/p&gt;&lt;p&gt;A friend of mine was in the process of grabbing cages and 17 cats from a cat rescue in LA when she was notified of an evacuation order for her area. She's trying to find an empty warehouse, preferably away from the fires, to keep the cats safe. If you can help, or know someone who can, please let me know ASAP.&lt;/p&gt;&quot;, 'tags': [], 'created_at': '2025-01-08 20:27:16', 'in_reply_to_id': None, 'reblog': None}" />
        </attvalues>
      </node>
