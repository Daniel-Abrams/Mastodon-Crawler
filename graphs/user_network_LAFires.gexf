          <attvalue for="0" value="{'id': '109315797595806969', 'username': 'mike', 'followers': 2741, 'following': 3168, 'bio': '&lt;p&gt;Winnipeg Jets fan, New Westminster Royals fan, liberal, curmudgeon in training. Canadian ambassador to Mastodon. Admin of &lt;a href=&quot;https://thecanadian.social&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;thecanadian.social&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt; and &lt;a href=&quot;https://journa.host&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;journa.host&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt; Find me on fediverse.info &lt;a href=&quot;https://thecanadian.social/tags/fedi22&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;fedi22&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://thecanadian.social/tags/Mastodon&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Mastodon&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://thecanadian.social/tags/TheCanadian&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TheCanadian&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;NOTICE: All content posted from this account is copyright Michael L Fraser. Any commercial reproduction or redistribution, including but not limited to AI learning models is strictly prohibited.&lt;/p&gt;', 'created_at': '2022-11-09 00:00:00'}" />
        </attvalues>
