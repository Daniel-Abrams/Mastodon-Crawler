          <attvalue for="0" value="{'id': '109824850164971498', 'username': 'DemocracyMattersALot', 'followers': 10458, 'following': 6395, 'bio': '&lt;p&gt;Husband/girl dad with faith that democracy is the way to go; still idealistic enough to believe it\'s achievable. The only thing I\'m selling is democracy. Banned (3x!) by the fowl site for calling out GOP lies.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://mstdn.social/tags/VoteBlue&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;VoteBlue&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/TwitterRefugees&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TwitterRefugees&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/WashingtonDC&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WashingtonDC&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/FightFascism&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FightFascism&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/NoRepublicans&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NoRepublicans&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mstdn.social/tags/Ukraine&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Ukraine&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2023-02-07 00:00:00'}" />
