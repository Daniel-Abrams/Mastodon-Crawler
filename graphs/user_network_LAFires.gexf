          <attvalue for="0" value="{'id': '109372023474003564', 'username': 'dancingdogs', 'followers': 802, 'following': 2190, 'bio': '&lt;p&gt;Header is a local mural. &lt;/p&gt;&lt;p&gt;Greetings. My interests—— &lt;a href=&quot;https://forall.social/tags/ai&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ai&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/politics&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;politics&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/gardening&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;gardening&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://forall.social/tags/climatechange&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;climatechange&lt;/span&gt;&lt;/a&gt;  &lt;br&gt;Previously worked in cinema. &lt;a href=&quot;https://forall.social/tags/unionstrong&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;unionstrong&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://forall.social/tags/humour&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;humour&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/birdwatcher&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;birdwatcher&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/astronomy&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;astronomy&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/flamenco&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;flamenco&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/science&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;science&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/nature&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;nature&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/BeKind&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;BeKind&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/coffee&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;coffee&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/Canada&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Canada&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/jazz&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;jazz&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/perfumery&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;perfumery&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/comedy&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;comedy&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/fashion&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;fashion&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/tech&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;tech&lt;/span&gt;&lt;/a&gt; &lt;/p&gt;&lt;p&gt;If you haven\'t filled out your profile or have 0 responses in your timeline, chances R I wont follow.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://forall.social/tags/covidsafehospitals&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;covidsafehospitals&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://forall.social/tags/Covid19isairborne&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Covid19isairborne&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;🟥Ventilation 🟥Filtration🟥 New indoor air standards&lt;/p&gt;&lt;p&gt;Toots autodelete after 2 wks&lt;/p&gt;', 'created_at': '2022-11-19 00:00:00'}" />
