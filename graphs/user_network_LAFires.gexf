          <attvalue for="0" value="{'id': '113084176274670187', 'username': 'avonan', 'followers': 179, 'following': 342, 'bio': '&lt;p&gt;Thoughts, words, action…&lt;a href=&quot;https://backend.newsmast.org/tags/activism&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;activism&lt;/span&gt;&lt;/a&gt; from &lt;a href=&quot;https://backend.newsmast.org/tags/Ohio&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Ohio&lt;/span&gt;&lt;/a&gt; &lt;br&gt;&lt;a href=&quot;https://backend.newsmast.org/tags/SlavaUkraini&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SlavaUkraini&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://backend.newsmast.org/tags/IStandWithUkraine&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;IStandWithUkraine&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;\u2028I care… &lt;a href=&quot;https://backend.newsmast.org/tags/ClimateCrisis&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateCrisis&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://backend.newsmast.org/tags/democracy&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;democracy&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://backend.newsmast.org/tags/justice&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;justice&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://backend.newsmast.org/tags/LGBTQIArights&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LGBTQIArights&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://backend.newsmast.org/tags/prisonreform&quot; class=&quot;mentio