        <attvalues>
          <attvalue for="0" value="{'id': '109291589253647141', 'username': 'SueInRockville', 'followers': 1079, 'following': 1017, 'bio': '&lt;p&gt;Forever Liberal Democrat. I always &lt;a href=&quot;https://mstdn.social/tags/VoteBlueNoMatterWho&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;VoteBlueNoMatterWho&lt;/span&gt;&lt;/a&gt;. Dedicated Meema of 6 - We will leave them a better world. Women’s Rights, Human Rights &amp;amp; Love &amp;amp; owner of www.Bren-Books.com - Come take a look&lt;/p&gt;', 'created_at': '2022-11-05 00:00:00'}" />
        </attvalues>
      </node>
