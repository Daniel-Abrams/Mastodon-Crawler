          <attvalue for="0" value="{'id': '109299534260958509', 'username': 'rhtunstall', 'followers': 1022, 'following': 1796, 'bio': '&lt;p&gt;Educated Monkey, Film Lighting Technician &amp;amp; Console Programmer/Operator. Former Camera Operator, Video Editor &amp;amp; Motion Graphics Technician. Grandson of the late Harry J. Hardy D.F.C. Pilot of the Pulverizers, &lt;a href=&quot;https://zeroes.ca/tags/WWII&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WWII&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/RCAF&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;RCAF&lt;/span&gt;&lt;/a&gt; 440 Squadron Leader. Glory to Ukraine. he/him\u2029&lt;a href=&quot;https://zeroes.ca/tags/IATSE891&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;IATSE891&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/etc&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;etc&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/eosfamily&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;eosfamily&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/programmer&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;programmer&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/lightingtech&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;lightingtech&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/film&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;film&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https: