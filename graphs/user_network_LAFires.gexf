        <attvalues>
          <attvalue for="0" value="{'id': '112378896428731146', 'username': 'mxhdroom', 'followers': 449, 'following': 411, 'bio': '&lt;p&gt;Retired career surfer. A fan of &lt;a href=&quot;https://mas.to/tags/travel&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;travel&lt;/span&gt;&lt;/a&gt;,  &lt;a href=&quot;https://mas.to/tags/sportscar&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;sportscar&lt;/span&gt;&lt;/a&gt; racing, &lt;a href=&quot;https://mas.to/tags/rally&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;rally&lt;/span&gt;&lt;/a&gt; and &lt;a href=&quot;https://mas.to/tags/motorsport&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;motorsport&lt;/span&gt;&lt;/a&gt; in general. &lt;a href=&quot;https://mas.to/tags/Miata&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Miata&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mas.to/tags/MX5&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MX5&lt;/span&gt;&lt;/a&gt; driver. I enjoy &lt;a href=&quot;https://mas.to/tags/driving&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;driving&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mas.to/tags/WRC&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WRC&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mas.to/tags/WEC&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WEC&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mas.to/tags/aviation&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;aviation&lt;/span&gt;&lt;/a&gt;, and &lt;a href=&quot;https://mas.to/tags/cycling&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;cycling&lt;/span&gt;&lt;/a&gt;. &lt;a href=&quot;https://mas.to/tags/fedi22&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;fedi22&lt;/span&gt;&lt;/a&gt;. Europhile. &lt;a href=&quot;https://mas.to/tags/SlavaUkraini&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SlavaUkraini&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2024-05-02 00:00:00'}" />
