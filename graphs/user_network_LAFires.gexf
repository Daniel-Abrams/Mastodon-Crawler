          <attvalue for="0" value="{'id': '109303024657562760', 'username': 'BlueWaver22', 'followers': 1109, 'following': 1016, 'bio': '&lt;p&gt;Researcher, writer/photographer. lover of books, libraries, travel,  European towns, food, wine, sea life #  &lt;a href=&quot;https://genomic.social/tags/TrumpEpstein&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TrumpEpstein&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://genomic.social/tags/FightForBlackRepresentation&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FightForBlackRepresentation&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://genomic.social/tags/FreePalestine&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FreePalestine&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://genomic.social/tags/WomensRights&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WomensRights&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://genomic.social/tags/WomenShouldRunEverything&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WomenShouldRunEverything&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://genomic.social/tags/SaveEarth&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SaveEarth&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://genomic.social/tags/GhislaineMaxwellIsAMonster&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;GhislaineMaxwellIsAMonster&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://genomic.social/tags/Fuk47&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Fuk47&lt;/sp