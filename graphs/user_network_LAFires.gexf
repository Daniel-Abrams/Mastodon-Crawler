          <attvalue for="0" value="{'id': '110265117580023916', 'username': 'hahn_cornelia', 'followers': 548, 'following': 1352, 'bio': '&lt;p&gt;&lt;a href=&quot;https://berlin.social/tags/SchwimmerBerlin&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SchwimmerBerlin&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://berlin.social/tags/RefugeesWelcome&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;RefugeesWelcome&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Born @~330 ppm CO2&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://berlin.social/tags/EDS&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;EDS&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://berlin.social/tags/Autismus&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Autismus&lt;/span&gt;&lt;/a&gt;, krankes Herz, &lt;a href=&quot;https://berlin.social/tags/ConnSyndrom&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ConnSyndrom&lt;/span&gt;&lt;/a&gt; ganz neu: &lt;a href=&quot;https://berlin.social/tags/Mischkollagenose&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Mischkollagenose&lt;/span&gt;&lt;/a&gt; &lt;/p&gt;&lt;p&gt;Verschwörungsquark wird blockiert&lt;/p&gt;&lt;p&gt;Keine sinnvolle Bildbeschreibung, kein Boost!&lt;/p&gt;&lt;p&gt;Avatar zeigt vor rotem Hintergrund ein weiblich gelesenes, gezeichnetes &quot;Passbild&quot;&lt;/p&gt;&lt;p&gt;Header sind die Climate Stripes von Berlin bzw. Brandenburg (links eher blau, rechts immer dunkler rot werdend)&lt;/p&gt;&lt;p&gt;Dw i\'n dysgu Cymraeg.&lt;/p&gt;', 'created_at': '2023-04-26 00:00:00'}" />
        </attvalues>
      </node>
