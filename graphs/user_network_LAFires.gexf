      <node id="109524642214014689" label="109524642214014689">
        <attvalues>
          <attvalue for="0" value="{'id': '109524642214014689', 'username': 'Beachbum', 'followers': 921, 'following': 1154, 'bio': '&lt;p&gt;No one or entity has permission to use my info or anything I post to support or use in any AI database or for use in any AI content! &lt;a href=&quot;https://mastodon.sdf.org/tags/AI&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;AI&lt;/span&gt;&lt;/a&gt; I’m in the USA. Land of the free home of the brave. \u2028A disruptive GOP is trying to create chaos in our Constitutional republic. Do not obey in advance! On Tyranny by Timothy Snyder \u2028#2547\u2028&lt;a href=&quot;https://mastodon.sdf.org/tags/tfgIsAFascist&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;tfgIsAFascist&lt;/span&gt;&lt;/a&gt; \u2028&lt;a href=&quot;https://mastodon.sdf.org/tags/SlavaUkraini&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SlavaUkraini&lt;/span&gt;&lt;/a&gt;\u2028&lt;a href=&quot;https://mastodon.sdf.org/tags/IMissPresidentBiden&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;IMissPresidentBiden&lt;/span&gt;&lt;/a&gt;\u2028&lt;a href=&quot;https://mastodon.sdf.org/tags/WeThePeople&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WeThePeople&lt;/span&gt;&lt;/a&gt;\u2028&lt;a href=&quot;https://mastodon.sdf.org/tags/EPluribusUnum&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;EPluribusUnum&lt;/span&gt;&lt;/a&gt;\u2028&lt;a href=&quot;https://mastodon.sdf.org/tags/FreedomNotFreedumb&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FreedomNotFreedumb&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.sdf.org/tags/TwitterMigration&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TwitterMigration&lt;/span&gt;&lt;/a&gt;\u2028She, her, they&lt;/p&gt;', 'created_at': '2022-12-16 00:00:00'}" />
