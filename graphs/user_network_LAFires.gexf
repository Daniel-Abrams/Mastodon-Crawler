          <attvalue for="0" value="{'id': '109689312661657062', 'username': 'snoozinsa', 'followers': 60, 'following': 393, 'bio': '&lt;p&gt;former bio research lab worker bee, &lt;a href=&quot;https://toad.social/tags/Cal&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Cal&lt;/span&gt;&lt;/a&gt; Bear&lt;/p&gt;&lt;p&gt;pro- democracy, science, nature, honesty &lt;br&gt;anti- fascism, corruption, cults, disinformation&lt;/p&gt;&lt;p&gt;not a fan of tycoons, moguls, oligarchs, OR magnates.  billionaires are parasites on civil society.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://toad.social/tags/StandWithUkraine&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;StandWithUkraine&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://toad.social/tags/russiaIsATerroristState&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;russiaIsATerroristState&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://toad.social/tags/NAFO&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NAFO&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://toad.social/tags/TaxTheRich&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TaxTheRich&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://toad.social/tags/NoBillionaires&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NoBillionaires&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&quot;With laws shall our land be built up but with lawlessness laid waste.&quot; - Njál Þorgeirsson, Njál\'s Saga&lt;/p&gt;&lt;p&gt;&quot;Successful systems attract parasites&quot; - Dickson Despommier&lt;/p&gt;', 'created_at': '2023-01-14 00:00:00'}" />
        </attvalues>
      </node>
