          <attvalue for="0" value="{'id': '109327912109511807', 'username': 'Avonan', 'followers': 1010, 'following': 2108, 'bio': '&lt;p&gt;Thoughts, words, action…#activism from &lt;a href=&quot;https://mas.to/tags/Ohio&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Ohio&lt;/span&gt;&lt;/a&gt;. &lt;a href=&quot;https://mas.to/tags/SlavaUkraini&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SlavaUkraini&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mas.to/tags/IStandWithUkraine&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;IStandWithUkraine&lt;/span&gt;&lt;/a&gt;\u2028\u2028I care… &lt;a href=&quot;https://mas.to/tags/ClimateCrisis&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateCrisis&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mas.to/tags/democracy&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;democracy&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mas.to/tags/justice&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;justice&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mas.to/tags/LGBTQIArights&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LGBTQIArights&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mas.to/tags/prisonreform&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;prisonreform&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mas.to/tags/immigrantjustice&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;immigrantjustice&lt;/span&gt;&lt