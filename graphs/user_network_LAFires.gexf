      <node id="109305315631888531" label="109305315631888531">
        <attvalues>
          <attvalue for="0" value="{'id': '109305315631888531', 'username': 'cvvhrn', 'followers': 2285, 'following': 2196, 'bio': '&lt;p&gt;I’m a pediatric critical care transport nurse (ground/rotor/fixed wing) and an avid published aviation photographer. I spot at Moffett, Travis, Pt Mugu, USAF Plant 42, Edwards AFB, TTR, Star Wars Canyon, and the R-2508 Sidewinder Low Level Complex. Nikon shooter with a Z9 and a D850 as backup.  Photos are mine unless boosted or noted &lt;a href=&quot;https://sfba.social/tags/AvGeek&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;AvGeek&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/Aviation&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Aviation&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/OSINT&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;OSINT&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/spotting&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;spotting&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/photography&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;photography&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/Nikon&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Nikon&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/Z9&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Z9&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/D850&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&