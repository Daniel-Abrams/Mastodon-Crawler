ackLivesMatter&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://zeroes.ca/tags/IndigenousAlly&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;IndigenousAlly&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://zeroes.ca/tags/Decolonization&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Decolonization&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://zeroes.ca/tags/Reparations&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Reparations&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://zeroes.ca/tags/Degrowth&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Degrowth&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://zeroes.ca/tags/ClimateCrisis&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateCrisis&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://zeroes.ca/tags/AnimalRights&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;AnimalRights&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-11-13 00:00:00'}" />
