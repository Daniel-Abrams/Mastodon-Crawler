          <attvalue for="0" value="{'id': '113044790377708253', 'username': 'Devils_Rancher', 'followers': 467, 'following': 729, 'bio': '&lt;p&gt;Grizzled Austin Music Stalwart, Caver, Screen Printer, Father, Photographer, Mac, Adobe end user, sober as a judge.&lt;/p&gt;&lt;p&gt;Austin, TX via the Castro. 🏳️\u200d🌈🏳️\u200d⚧️ally. &lt;a href=&quot;https://beige.party/tags/MeFite&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MeFite&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;He/him, Father of Jacob The Pancake Monger &amp;amp; Erin The Rocketship Builder&lt;/p&gt;&lt;p&gt;On fedi since 2017, migrated to beige from The Octodon.social in ‘24.&lt;/p&gt;&lt;p&gt;Header: Howl obscenity trial 1957&lt;/p&gt;&lt;p&gt;Buy me a coffee! &lt;a href=&quot;https://ko-fi.com/chrisvreeland74719&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;ko-fi.com/chrisvreeland74719&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2024-08-04 00:00:00'}" />
