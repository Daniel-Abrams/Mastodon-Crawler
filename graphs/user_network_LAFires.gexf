          <attvalue for="0" value="{'id': '109293146162093924', 'username': 'haljor', 'followers': 299, 'following': 211, 'bio': '&lt;p&gt;Graphic art, video games, classic TV and movies.  Reluctant techie.  Introvert.  Dog dad.  He/They.  San Francisco resident since the Clinton administration.&lt;/p&gt;&lt;p&gt;&quot;Fear is the enemy of will. Will is what makes you take action; fear is what stops you, and makes you weak.&quot;&lt;br&gt;-- Sinestro to Hal Jordan, &quot;Green Lantern&quot; (2011)&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://sfba.social/tags/noindex&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;noindex&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/nobots&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;nobots&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://sfba.social/tags/noai&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;noai&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-11-05 00:00:00'}" />
