          <attvalue for="0" value="{'id': '109243612827711926', 'username': 'clmerle', 'followers': 638, 'following': 453, 'bio': '&lt;p&gt;Some call me Chris.&lt;/p&gt;&lt;p&gt;The &lt;a href=&quot;https://mstdn.social/tags/polycrisis&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;polycrisis&lt;/span&gt;&lt;/a&gt; is here! &lt;a href=&quot;https://mstdn.social/tags/Stoicism&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Stoicism&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mstdn.social/tags/Solarpunk&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Solarpunk&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mstdn.social/tags/Python&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Python&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mstdn.social/tags/craftBeer&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;craftBeer&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mstdn.social/tags/mezcal&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;mezcal&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mstdn.social/tags/Scotch&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Scotch&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mstdn.social/tags/donuts&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;donuts&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mstdn.social/tags/fountainPens&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;fountainPens&lt;/span&gt;&lt;/a&gt;, &