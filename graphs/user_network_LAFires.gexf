        <attvalues>
          <attvalue for="0" value="{'id': '109705635112763642', 'username': 'dannotdaniel', 'followers': 2792, 'following': 5403, 'bio': '&lt;p&gt;your friendly neighborhood cheesemonger&lt;/p&gt;&lt;p&gt;HERE for:&lt;br&gt;🧀 cheese&lt;br&gt;🏛️ democracy&lt;br&gt;🎨 art, animations, &lt;a href=&quot;https://hellions.cloud/tags/pixelart&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;pixelart&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://hellions.cloud/tags/b3d&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;b3d&lt;/span&gt;&lt;/a&gt;&lt;br&gt;📷 photography&lt;br&gt;🎸 tasty solos&lt;br&gt;🤓 nerdery&lt;/p&gt;&lt;p&gt;NOT:&lt;br&gt;🚫 not &quot;expecting follow back&quot;&lt;br&gt;🚫 not into crypto / adjacent scams&lt;br&gt;:no_kings_spin: no kings&lt;br&gt;:ai_free: no AI&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://hellions.cloud/tags/StandWithUkraine&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;StandWithUkraine&lt;/span&gt;&lt;/a&gt; 🇺🇦&lt;br&gt;&lt;a href=&quot;https://hellions.cloud/tags/MaskUp&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MaskUp&lt;/span&gt;&lt;/a&gt; 💉😷&lt;br&gt;&lt;a href=&quot;https://hellions.cloud/tags/CheezeEmAll&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CheezeEmAll&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://hellions.cloud/tags/BrieBest&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;BrieBest&lt;/span&gt;&lt;/a&gt; 🧀 :cheese_brie: :cheese_american:&lt;br&gt;&lt;a href=&quot;https://hellions.cloud/tags/mastodon&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;m