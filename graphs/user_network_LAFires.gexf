      <node id="109366519617971710" label="109366519617971710">
        <attvalues>
          <attvalue for="0" value="{'id': '109366519617971710', 'username': 'berndandeweg', 'followers': 399, 'following': 331, 'bio': '&lt;p&gt;Geoscientist in a broad sense. Trained in fieldwork, tectonics, structural geology, and sedimentary geology. Adding new techniques and data from diverse backgrounds to understand the Earth a bit better. I am trying to pass on my enthusiasm, knowledge, and skills to students and the broader public.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://mastodon.nl/tags/tectonics&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;tectonics&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/geology&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;geology&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/aardwetenschappen&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;aardwetenschappen&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/volcanoes&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;volcanoes&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/structural&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;structural&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/espa%C3%B1a&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;españa&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/teaching&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;teaching&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/field&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;field&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/VrijeUniversiteit&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;VrijeUniversiteit&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/amsterdam&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;amsterdam&lt;/span&gt;&lt;/a&gt; &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://social.edu.nl/@vuamsterdam&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;vuamsterdam&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; &lt;a href=&quot;https://mastodon.nl/tags/aardbeving&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;aardbeving&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/vulkaan&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;vulkaan&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/uitbarsting&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;uitbarsting&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.nl/tags/IJsland&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;IJsland&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-11-18 00:00:00'}" />
