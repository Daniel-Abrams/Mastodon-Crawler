          <attvalue for="0" value="{'id': '109893062787703479', 'username': 'RiaResists', 'followers': 1925, 'following': 2661, 'bio': '&lt;p&gt;Hello! \u2028I ❤️ &lt;a href=&quot;https://mastodon.social/tags/nature&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;nature&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/animals&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;animals&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/history&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;history&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/travel&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;travel&lt;/span&gt;&lt;/a&gt;&lt;br /&gt;I like to garden, cook, hang out w friends &amp;amp; protest. &lt;br /&gt;I boost a LOT. Especially pet pics 😃\u2028Despise all things right wing. &lt;br /&gt;We must &lt;a href=&quot;https://mastodon.social/tags/Unite&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Unite&lt;/span&gt;&lt;/a&gt; against &lt;a href=&quot;https://mastodon.social/tags/fascism&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;fascism&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2023-02-19 00:00:00'}" />
