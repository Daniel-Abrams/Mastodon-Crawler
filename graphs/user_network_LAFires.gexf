          <attvalue for="0" value="{'id': '343472', 'username': 'electricarchaeo', 'followers': 1967, 'following': 795, 'bio': '&lt;p&gt;prof of DH at carleton u. Archaeologist of things Digital, Roman, and Outer Space. Editor of epoiesen.carleton.ca. Sometimes blog at electricarchaeology.ca &lt;a href=&quot;https://scholar.social/tags/digiarch&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;digiarch&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://scholar.social/tags/archaeology&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;archaeology&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://scholar.social/tags/histodons&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;histodons&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://scholar.social/tags/archaeodons&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;archaeodons&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://scholar.social/tags/dh&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;dh&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://scholar.social/tags/publichistory&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;publichistory&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2018-04-30 00:00:00'}" />
