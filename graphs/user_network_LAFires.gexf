      <node id="109358544043904637" label="109358544043904637">
        <attvalues>
          <attvalue for="0" value="{'id': '109358544043904637', 'username': 'Incognitim', 'followers': 2019, 'following': 4428, 'bio': '&lt;p&gt;&lt;a href=&quot;https://www.wired.com/2008/07/thomas-jeffersons-all-american-incognitum/&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;ellipsis&quot;&gt;wired.com/2008/07/thomas-jeffe&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;rsons-all-american-incognitum/&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Howdy! 👋&lt;/p&gt;&lt;p&gt;I&amp;#39;m interested in basically everything, as depicted in the emoji extravaganza below. &lt;/p&gt;&lt;p&gt;I favourite frequently &amp;amp; follow freely, &amp;#39;cause that&amp;#39;s what makes the fediverse fun! 🤓&lt;/p&gt;&lt;p&gt;&amp;#39;We can have democracy, or extreme wealth...but we can&amp;#39;t have both.&amp;#39;&lt;br /&gt;- Justice Brandeis&lt;/p&gt;&lt;p&gt;Thanks for stopping by! Have a good one! 💚&lt;/p&gt;&lt;p&gt;Profile: just the cutest lil hell-raising pupper in the world!&lt;br /&gt;Header: sleepy black cat 🖤RIP Shadow🖤&lt;/p&gt;', 'created_at': '2022-11-17 00:00:00'}" />
        </attvalues>
