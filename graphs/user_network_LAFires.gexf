        <attvalues>
          <attvalue for="0" value="{'id': '109242391821775087', 'username': 'steve', 'followers': 3311, 'following': 854, 'bio': '&lt;p&gt;Director, School of the Environment, University of Toronto. Professor of Computer Science. I study how climate models are built &amp;amp; tested + systems thinking for sustainability. New book, Computing the Climate, order it here:  &lt;a href=&quot;https://www.cambridge.org/9781107589926&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://www.&lt;/span&gt;&lt;span class=&quot;&quot;&gt;cambridge.org/9781107589926&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt;&lt;br&gt;He/him&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://fediscience.org/tags/Climate&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Climate&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Sustainability&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Sustainability&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Environment&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Environment&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Resilience&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Resilience&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/STS&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;STS&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Transdisciplinarity&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Transdisciplinarity&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Community&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Community&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Complexity&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Complexity&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/SystemsThinking&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SystemsThinking&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/ClimateJustice&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ClimateJustice&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/LandBack&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LandBack&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Feminism&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Feminism&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/TransRights&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TransRights&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Ecology&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Ecology&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/Computing&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Computing&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://fediscience.org/tags/ML&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; targe