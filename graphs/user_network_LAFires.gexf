        <attvalues>
          <attvalue for="0" value="{'id': '111270616296004000', 'username': 'camless', 'followers': 582, 'following': 471, 'bio': '&lt;p&gt;He/him, views own. I do not speak for, nor represent my employer. Living on ceded &lt;a href=&quot;https://m.ai6yr.org/tags/kalapuya&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;kalapuya&lt;/span&gt;&lt;/a&gt; land.&lt;/p&gt;&lt;p&gt;Wildland firefighter, incident commander, disaster recovery program lead, public servant. Card-carrying union member.&lt;/p&gt;&lt;p&gt;Boosts /= support but shows interest.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://m.ai6yr.org/tags/wx&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;wx&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/emgtoot&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;emgtoot&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/pnw&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;pnw&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/or&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;or&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/wa&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;wa&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/orwx&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;orwx&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.org/tags/wawx&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;wawx&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://m.ai6yr.o