          <attvalue for="0" value="{'id': '109949448023989061', 'username': 'corbden', 'followers': 2648, 'following': 1397, 'bio': '&lt;p&gt;Author, ghostwriter, freelance editor who wrote &quot;Recovering Agency: Lifting the Veil of Mormon Mind Control.&quot;&lt;/p&gt;&lt;p&gt;&quot;Abuse Culture&quot; is the cult of American society.&lt;/p&gt;&lt;p&gt;Also F/SF/Horror author. Many other interests &amp;amp; infodumps. Former IT.&lt;/p&gt;&lt;p&gt;4% puns, 7% dad jokes. Absent minded &amp;amp; trauma-addled aspirational hippie.&lt;/p&gt;&lt;p&gt;♥Cult Researcher&lt;br&gt;♥Exmormon&lt;br&gt;♥Mystical Atheist&lt;br&gt;♥Autist &lt;br&gt;♥Survivor&lt;br&gt;♥GenXtra&lt;br&gt;♥Solarpunk&lt;br&gt;♥Whiteness is a cult&lt;br&gt;♥Decolonize &amp;amp; Rewild&lt;br&gt;♥End &lt;a href=&quot;https://defcon.social/tags/AbuseCulture&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;AbuseCulture&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;I’ll help you see through the illusion.&lt;/p&gt;', 'created_at': '2023-02-17 00:00:00'}" />
        </attvalues>
      </node>
      <node id="112548279204190396" label="112548279204190396">
        <attvalues>
          <attvalue for="0" value="{'id': '112548279204190396', 'username': 'PeasLuvnJustice', 'followers': 431, 'following': 571, 'bio': '&lt;p&gt;America is not OK 💔 Congress, FIGHT BACK!!!! &lt;a href=&quot;https://mastodon.social/tags/TraitorsSupportTraitortrump&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;TraitorsSupportTraitortrump&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Project2025&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Project2025&lt;/span&gt;&lt;/a&gt; is a threat to America. &lt;a href=&quot;https://mastodon.social/tags/AbolushICE&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;AbolushICE&lt;/span&gt;&lt;/a&gt;. I Vote, ANTIFA like my Grandfather, &lt;a href=&quot;https://mastodon.social/tags/BansOffOurBodies&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;BansOffOurBodies&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/trumpAbortionBans&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;trumpAbortionBans&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/NazisSuk&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;NazisSuk&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Vote&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Vote&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/ReadBannedBooks&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;ReadBannedBooks&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/DeportTheNazis&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;DeportTheNazis&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/WorldPeace&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;WorldPeace&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/VotingRights&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;VotingRights&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/LGBTQAlly&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;LGBTQAlly&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/ClimateChangeIsReal&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;ClimateChangeIsReal&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/WeThePeople&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;WeThePeople&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/NeverGQP&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;NeverGQP&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/EndCitizensUnited&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;EndCitizensUnited&lt;/span&gt;&lt;/a&gt; &lt;br /&gt;Other countries have &lt;a href=&quot;https://mastodon.social/tags/UniversalHealthcare&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;UniversalHealthcare&lt;/span&gt;&lt;/a&gt; &lt;br /&gt;So can we! &lt;a href=&quot;https://mastodon.social/tags/ReleaseTheEpsteinFiles&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;ReleaseTheEpsteinFiles&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2024-06-02 00:00:00'}" />
