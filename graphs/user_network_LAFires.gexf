      <node id="112008528674690846" label="112008528674690846">
        <attvalues>
          <attvalue for="0" value="{'id': '112008528674690846', 'username': 'BlippyTheWonderSlug', 'followers': 1433, 'following': 1817, 'bio': '&lt;p&gt;Blippy, a suspiciously majestic Sea Slug of some sort, was found in a Nuclear/Biological waste disposal facility near Oldenburg, Germany sometime in 1959.&lt;/p&gt;&lt;p&gt;⚠️ 👉 Potty mouth. 👈 ⚠️&lt;/p&gt;&lt;p&gt;Deutscher, aber sprecht kaum Deutsch.&lt;/p&gt;&lt;p&gt;Monster. No gods, no kings. Likely a psychopath. Honestly, you\'re better off muting me.&lt;/p&gt;&lt;p&gt;--&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://ieji.de/tags/Audrey&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Audrey&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://ieji.de/tags/PoultryCoroner&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;PoultryCoroner&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://ieji.de/tags/RandomShoes&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;RandomShoes&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://ieji.de/tags/BongSignal&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;BongSignal&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://ieji.de/tags/TheArtOfShitposting&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;TheArtOfShitposting&lt;/span&gt;&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://ieji.de/tags/AmericanPresidentGoFuckYourself&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;AmericanPresidentGoFuckYourself&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Cats: &lt;a href=&quot;https://ieji.de/tags/EmmaPeel&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&