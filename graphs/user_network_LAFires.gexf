          <attvalue for="0" value="{'id': '109999119965425489', 'username': 'benroyce', 'followers': 6924, 'following': 3577, 'bio': '&lt;p&gt;𝕥𝕙𝕖 𝕥𝕪𝕘𝕖𝕣𝕤 𝕠𝕗 𝕨𝕣𝕒𝕥𝕙 𝕒𝕣𝕖 𝕨𝕚𝕤𝕖𝕣 𝕥𝕙𝕒𝕟 𝕥𝕙𝕖 𝕙𝕠𝕣𝕤𝕖𝕤 𝕠𝕗 𝕚𝕟𝕤𝕥𝕣𝕦𝕔𝕥𝕚𝕠𝕟&lt;/p&gt;&lt;p&gt;i am a hothead and a loudmouth&lt;/p&gt;&lt;p&gt;ᵗʰⁱˢ ⁱˢ ᵗʰᵉ ᵒⁿˡʸ ˢᵒᶜⁱᵃˡ ᵐᵉᵈⁱᵃ ᵃᶜᶜᵒᵘⁿᵗ ⁱ ʰᵃᵛᵉ&lt;br /&gt;ᵃⁿʸ ᵒᵗʰᵉʳ &amp;quot;ᴮᵉⁿ ᴿᵒʸᶜᵉ&amp;quot; ʸᵒᵘ ˢᵉᵉ ᵒᵘᵗ ᵗʰᵉʳᵉ ᵒⁿ ᵗʰᵉ ᶠᵉᵈⁱᵛᵉʳˢᵉ ᵒʳ ᵒⁿ ᵃⁿʸ ᵒᵗʰᵉʳ ᵖˡᵃᵗᶠᵒʳᵐ ⁱˢ ⁿᵒᵗ ᵐᵉ&lt;/p&gt;&lt;p&gt;i live near &lt;a href=&quot;https://mastodon.social/tags/RochesterNY&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;RochesterNY&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Rochester&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Rochester&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/NewYork&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;NewYork&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/NY&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;NY&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/FingerLakes&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;FingerLakes&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/WesternNY&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;WesternNY&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Ganondagan&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Ganondagan&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2023-03-10 00:00:00'}" />
