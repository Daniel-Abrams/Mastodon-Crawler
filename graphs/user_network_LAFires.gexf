          <attvalue for="0" value="{'id': '109292215287356826', 'username': 'paninid', 'followers': 3054, 'following': 2354, 'bio': '&lt;p&gt;Come for the &lt;a href=&quot;https://mastodon.world/tags/shitposting&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;shitposting&lt;/span&gt;&lt;/a&gt;, &lt;br&gt;stay for the &lt;a href=&quot;https://mastodon.world/tags/sensemaking&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;sensemaking&lt;/span&gt;&lt;/a&gt;.&lt;/p&gt;&lt;p&gt;Absurdly restless seeker 🇺🇸&lt;br&gt;Inadvertent chronicler 📚&lt;br&gt;Too unconventional for mainstream&lt;/p&gt;&lt;p&gt;ruthlessly calling out &lt;br&gt;shouting out&lt;br&gt;up GA-400 🔥&lt;/p&gt;&lt;p&gt;humanist ❤️\u200d🔥&lt;br&gt;&lt;a href=&quot;https://mastodon.world/tags/history&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;history&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/language&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;language&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/comedy&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;comedy&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/sensemaking&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;sensemaking&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/institutions&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;institutions&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/information&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;information&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/education&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;education&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/psychology&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;psychology&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/culture&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;culture&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://mastodon.world/tags/governance&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;governance&lt;/span&gt;&lt;/a&gt;, &amp;amp; being &lt;a href=&quot;https://mastodon.world/tags/American&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;American&lt;/span&gt;&lt;/a&gt;🖖🏼&lt;/p&gt;&lt;p&gt;Revolution Will Be Joyfully Memeticized™ &lt;/p&gt;&lt;p&gt;Big Red MBA ❤️&lt;br&gt;Autodidacto 🇲🇽&lt;br&gt;Big Orange Engineer 🧡&lt;/p&gt;', 'created_at': '2022-11-04 00:00:00'}" />
