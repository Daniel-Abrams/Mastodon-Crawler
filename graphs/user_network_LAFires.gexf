        <attvalues>
          <attvalue for="0" value="{'id': '109385180018942297', 'username': 'constantorbit', 'followers': 1510, 'following': 2789, 'bio': '&lt;p&gt;The short bio (see pinned &lt;a href=&quot;https://hachyderm.io/tags/introduction&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;introduction&lt;/span&gt;&lt;/a&gt; for longer)&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://hachyderm.io/tags/SoftwareDeveloper&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SoftwareDeveloper&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://hachyderm.io/tags/musician&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;musician&lt;/span&gt;&lt;/a&gt; -- lifelong &lt;a href=&quot;https://hachyderm.io/tags/choral&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;choral&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://hachyderm.io/tags/singer&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;singer&lt;/span&gt;&lt;/a&gt; &amp;amp; just picked up &lt;a href=&quot;https://hachyderm.io/tags/BassGuitar&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;BassGuitar&lt;/span&gt;&lt;/a&gt; again.  |  wannabe &lt;a href=&quot;https://hachyderm.io/tags/vegetarian&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;vegetarian&lt;/span&gt;&lt;/a&gt;, wannabe &lt;a href=&quot;https://hachyderm.io/tags/buddhist&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;buddhist&lt;/span&gt;&lt;/a&gt;, &lt;a href=&quot;https://hachyderm.io/tags/uu&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;uu&lt;/span&gt;&lt;/a&gt;  |  Cisgender, straight, &lt;a href=&quot;https://hachyderm.io/tags/ally&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ally&lt;/span&gt;&lt;/a&gt;  |  Very &lt;a href=&quot;https://hachyderm.io/tags/liberal&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;liberal&lt;/span&gt;&lt;/a&gt; / &lt;a href=&quot;https://hachyderm.io/tags/progressive&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;progressive&lt;/span&gt;&lt;/a&gt;  |  &lt;a href=&quot;https://hachyderm.io/tags/california&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;california&lt;/span&gt;&lt;/a&gt; (hopefully for the remainder of my time on this planet)  |  &lt;a href=&quot;https://hachyderm.io/tags/photography&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;photography&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-11-22 00:00:00'}" />
