          <attvalue for="0" value="{'id': '113447470257745607', 'username': 'yuhasz01', 'followers': 612, 'following': 2506, 'bio': '&lt;p&gt;By changing nothing, nothing changes...&lt;/p&gt;&lt;p&gt;Economic and social equality and justice for All..&lt;/p&gt;&lt;p&gt;Open science ,open data and open software &lt;br /&gt;Climate change impact mitigation. Clean air, food and water are basic human rights .&lt;br /&gt;Universal Healthcare for all. &lt;br /&gt;Black &amp;amp; White photography&lt;br /&gt;&lt;a href=&quot;https://mastodon.social/tags/openscience&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;openscience&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/opensourcesoftware&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;opensourcesoftware&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/security&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;security&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/dataprivacy&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;dataprivacy&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/machinelearningmodels&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;machinelearningmodels&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/economicinequality&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;economicinequality&lt;/span&gt;&lt;/a&gt;#socialmedia&lt;br /&gt;&lt;a href=&quot;https://mastodon.social/tags/disinformation&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;disinformation&lt;/span&gt;&lt;/a&gt;#digitaldemocracy&lt;/p&gt;', 'created_at': '2024-11-08 00:00:00'}" />
