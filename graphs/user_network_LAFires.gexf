        <attvalues>
          <attvalue for="0" value="{'id': '109298137478783154', 'username': 'xris', 'followers': 1674, 'following': 2010, 'bio': '&lt;p&gt;They/Them&lt;/p&gt;&lt;p&gt;Certified Interpretive Guide&lt;br&gt;New York Master Naturalist&lt;br&gt;ORCID: &lt;a href=&quot;https://orcid.org/0000-0001-9563-5815&quot; rel=&quot;nofollow noopener&quot; translate=&quot;no&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;invisible&quot;&gt;https://&lt;/span&gt;&lt;span class=&quot;&quot;&gt;orcid.org/0000-0001-9563-5815&lt;/span&gt;&lt;span class=&quot;invisible&quot;&gt;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Ecoregion 59g (#Brooklyn, &lt;a href=&quot;https://ecoevo.social/tags/NYC&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NYC&lt;/span&gt;&lt;/a&gt;)&lt;br&gt;b. 315ppm CO2&lt;br&gt;he/they &lt;/p&gt;&lt;p&gt;Moar tagz:&lt;br&gt;&lt;a href=&quot;https://ecoevo.social/tags/gay&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;gay&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://ecoevo.social/tags/queer&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;queer&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://ecoevo.social/tags/LGBTQIA&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LGBTQIA&lt;/span&gt;&lt;/a&gt; &lt;br&gt;&lt;a href=&quot;https://ecoevo.social/tags/NewYorkCity&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NewYorkCity&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://ecoevo.social/tags/NewYork&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NewYork&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://ecoevo.social/tags/Photography&quot; class=&quot;mention hashtag