          <attvalue for="0" value="{'id': '112145682185865409', 'username': 'jaztrophysicist', 'followers': 447, 'following': 607, 'bio': '&lt;p&gt;Avant j\'étais fuséologue et je jouais de la musique mais ça c\'était avant et on peut pas changer de handle&lt;/p&gt;&lt;p&gt;Influenceur &lt;a href=&quot;https://social.sciences.re/tags/ErmiteDesMontagnes&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ErmiteDesMontagnes&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.sciences.re/tags/LAriegeCestMoche&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LAriegeCestMoche&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.sciences.re/tags/LaTaniere&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;LaTaniere&lt;/span&gt;&lt;/a&gt; &lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://social.sciences.re/tags/Nature&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Nature&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.sciences.re/tags/garden&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;garden&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.sciences.re/tags/birding&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;birding&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.sciences.re/tags/photography&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;photography&lt;/span&gt;&lt;/a&gt;  &lt;a href=&quot;https://social.sciences.re/tags/MountainBiking&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MountainBiking&lt;/span&gt;&lt;/a&gt;  🚵\u200d♂️ &lt;/p&gt;&lt;p&gt;Upright &lt;a href=&quot;https://social.sciences.re/tags/Bass&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Bass&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.sciences.re/tags/Jazz&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Jazz&lt;/span&gt;&lt;/a&gt; &lt;/p&gt;&lt;p&gt;&quot;Musico-scientifique chelou&quot;, &quot;paparoizzo&quot;, &quot;chieur atomique&quot; (&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://mastodon.top/@Qi2Navet&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;Qi2Navet&lt;/span&gt;&lt;/a&gt;&lt;/span&gt;)&lt;/p&gt;&lt;p&gt;&quot;Fait autre chose avec des équations mais on sait pas quoi&quot; (&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://piaille.fr/@MadameMollette&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;MadameMollette&lt;/span&gt;&lt;/a&gt;&lt;/span&gt;)&lt;/p&gt;&lt;p&gt;PP vis coupée en 2 dans le sens de la longueur&lt;/p&gt;&lt;p&gt;Banner: sommets et vallons du Couserans&lt;/p&gt;', 'created_at': '2024-03-23 00:00:00'}" />
