      <node id="109334374718728328" label="109334374718728328">
        <attvalues>
          <attvalue for="0" value="{'id': '109334374718728328', 'username': 'broadwaybabyto', 'followers': 4112, 'following': 480, 'bio': '&lt;p&gt;Disabled &amp;amp; chronically ill writer. Former theatre critic. Passionate about disability rights, clean air, masks and covid caution. Clean air is a human right &amp;amp; masks work.&lt;/p&gt;&lt;p&gt;I write about the experience of being highly vulnerable during a pandemic, isolation, loss of healthcare and euthanasia. My focus is on how we can find support, fight back &amp;amp; create better systems and safety nets everyone. &lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://zeroes.ca/tags/CovidisAirborne&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CovidisAirborne&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/Disability&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Disability&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/Pandemic&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Pandemic&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/MasksWork&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MasksWork&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/CleanAir&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CleanAir&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/Ableism&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Ableism&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/ChronicIllness&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ChronicIllness&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://zeroes.ca/tags/CovidIsNotOver&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CovidIsNotOver&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-11-13 00:00:00'}" />
