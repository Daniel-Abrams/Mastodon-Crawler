          <attvalue for="0" value="{'id': '109382093344816730', 'username': 'tmstreet', 'followers': 475, 'following': 373, 'bio': '&lt;p&gt;biking,hiking, walking, car free cities, former TAB member, ., climate, ebikes, planet lover, urbanism,solar, wind,#thewaroncars &lt;a href=&quot;https://urbanists.social/tags/keepitintheground&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;keepitintheground&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://urbanists.social/tags/fuckelon&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;fuckelon&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://urbanists.social/tags/bikewhenucan&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;bikewhenucan&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://urbanists.social/tags/degrowth&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;degrowth&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://urbanists.social/tags/fuckfossilfuels&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;fuckfossilfuels&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://urbanists.social/tags/wehaveenough&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;wehaveenough&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://urbanists.social/tags/vegan&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;vegan&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://urbanists.social/tags/catlover&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;catlover&lt;/span&gt;&lt;/a&gt;  &lt;a href=&quot;https://urbanists.social/tags/carlitelife&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;carlitelife&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-11-21 00:00:00'}" />
