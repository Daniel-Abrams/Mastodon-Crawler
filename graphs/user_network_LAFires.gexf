          <attvalue for="0" value="{'id': '109301624754661647', 'username': 'Andres4NY', 'followers': 1541, 'following': 381, 'bio': '&lt;p&gt;he/him.  from the birdsite (&lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://social.ridetrans.it/@Andres4NY&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;Andres4NY&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; and before that @NEGreenways).&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://social.ridetrans.it/tags/Dad&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Dad&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/NYC&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NYC&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/Bikes&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Bikes&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/FreeTransit&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FreeTransit&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/SafeStreets&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;SafeStreets&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/BanCars&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;BanCars&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/Debian&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Debian&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/FreeSoftware&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FreeSoftware&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/ACAB&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;ACAB&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/Vegetarian&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Vegetarian&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://social.ridetrans.it/tags/WearAMask&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;WearAMask&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;You might remember me from such instructional videos as, &quot;Mothballing Your Battleship&quot; and &quot;Dig Your Own Grave and Save!&quot;&lt;/p&gt;&lt;p&gt;My wife\'s an &lt;a href=&quot;https://social.ridetrans.it/tags/epidemiologist&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;epidemiologist&lt;/span&gt;&lt;/a&gt;, so you\'ll get some &lt;a href=&quot;https://social.ridetrans.it/tags/COVID&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;COVID&lt;/span&gt;&lt;/a&gt; talk too.&lt;/p&gt;&lt;p&gt;Trans rights are human rights.&lt;/p&gt;', 'created_at': '2022-11-07 00:00:00'}" />
