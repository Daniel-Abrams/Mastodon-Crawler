          <attvalue for="0" value="{'id': '109276087030631457', 'username': 'GertrudeZane', 'followers': 1060, 'following': 802, 'bio': '&lt;p&gt;I\'m a grandma of 6 living in a very red district in a blue state in the USA with my husband, 5 cats and a dog.  Cats are:  Pax, Sunday, Peck, Doodle and Daphne.  Dog is Kukla.  &lt;/p&gt;&lt;p&gt;I love democracy, nature walks, researching family history and eating chocolate.  Resist fascism! Slava Ukraini!🇺🇦 Let\'s support each other and be kind!&lt;/p&gt;&lt;p&gt;No DMs please.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://c.im/tags/CatsOfMastodon&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;CatsOfMastodon&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/Cats&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Cats&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/BloomScrolling&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;BloomScrolling&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/DogsOfMastodon&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;DogsOfMastodon&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/MonDog&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;MonDog&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/Nature&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Nature&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/Taiwan&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Taiwan&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/Democracy&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Democracy&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/Caturday&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Caturday&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/Ukraine&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Ukraine&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/Pax&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Pax&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/Crochet&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Crochet&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://c.im/tags/NoTagsPub&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;NoTagsPub&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-10-30 00:00:00'}" />
