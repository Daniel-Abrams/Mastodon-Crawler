          <attvalue for="0" value="{'id': '109308785349635677', 'username': 'TCMuffin', 'followers': 1558, 'following': 1998, 'bio': '&lt;p&gt;Jayne Samuel-Walker&lt;br&gt;:wales_flag: 🇪🇺 :flag_rainbow: :flag_trans:&lt;br&gt;💻 :twt: :mastodon: :fediverse:&lt;/p&gt;&lt;p&gt;I’m an old IT pro. Co-mum to Tig and Freddie, rescued Border Collies x Welsh Sheepdogs. They are the latest of our greatly loved and now hugely missed dogs.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://toot.wales/tags/GTTO&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;GTTO&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://toot.wales/tags/FBPE&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FBPE&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://toot.wales/tags/FBPPR&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FBPPR&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://toot.wales/tags/FBIW&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;FBIW&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://toot.wales/tags/Woke&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Woke&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://toot.wales/tags/Wales&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;Wales&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-11-08 00:00:00'}" />
