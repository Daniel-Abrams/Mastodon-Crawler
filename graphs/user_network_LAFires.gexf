      <node id="109489886193176807" label="109489886193176807">
        <attvalues>
          <attvalue for="0" value="{'id': '109489886193176807', 'username': 'wellingtonrock', 'followers': 2722, 'following': 4613, 'bio': '&lt;p&gt;Y I K E S... &lt;br /&gt;It appears my profile has been copied by a user - hfdgsj648@mastodon.social.&lt;br /&gt;WHO ARE YOU? WHAT&amp;#39;S YOUR GAME &lt;/p&gt;&lt;p&gt;Still&lt;br /&gt;... to paraphrase POTUS, a &amp;#39;Radical Left Lunatic&amp;#39; who loves fairness, equality and DEI.&lt;/p&gt;&lt;p&gt;I&amp;#39;ve studied Classical Guitar since retiring, and can now read music reasonably. I&amp;#39;ve played Acoustic Guitar, intermittently, for most of my adult life. I&amp;#39;ve also taken up the Mandolin in recent years. &lt;br /&gt;Just learning about hashtags... &lt;a href=&quot;https://mastodon.social/tags/fbpe&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;fbpe&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/wokerati&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;wokerati&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/ClassicalGuitar&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;ClassicalGuitar&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/Mandolin&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;Mandolin&lt;/span&gt;&lt;/a&gt; &lt;a href=&quot;https://mastodon.social/tags/MMT&quot; class=&quot;mention hashtag&quot; rel=&quot;tag&quot;&gt;#&lt;span&gt;MMT&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;', 'created_at': '2022-12-10 00:00:00'}" />
