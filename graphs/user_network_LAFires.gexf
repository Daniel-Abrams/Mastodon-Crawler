        <attvalues>
          <attvalue for="0" value="{'id': '109524768408930919', 'username': 'numbercrow', 'followers': 324, 'following': 1029, 'bio': '&lt;p&gt;I am a proud father of two amazing children, I have a wonderful wife who is also a teacher. I love playing music, guitar mostly, but I like other stringed instruments. I love to make things with my hands and with machines controlled by my hands. I am worried about our children\'s future and feel that I most closely align with &lt;a href=&quot;https://techhub.social/tags/anarchy&quot; class=&quot;mention hashtag&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;#&lt;span&gt;anarchy&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Now on pixelfed: &lt;span class=&quot;h-card&quot; translate=&quot;no&quot;&gt;&lt;a href=&quot;https://techhub.social/@numbercrow&quot; class=&quot;u-url mention&quot; rel=&quot;nofollow noopener&quot; target=&quot;_blank&quot;&gt;@&lt;span&gt;numbercrow&lt;/span&gt;&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;', 'created_at': '2022-12-16 00:00:00'}" />
        </attvalues>
      </node>
